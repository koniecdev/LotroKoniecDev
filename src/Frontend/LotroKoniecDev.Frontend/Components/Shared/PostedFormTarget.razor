@using LotroKoniecDev.Frontend.Infrastructure.Forms

@* Blazor sends a post only to a form that is on the rendered page, and otherwise answers 400 with a blank
   page (#1122). A page that draws its form only when its data loaded puts this in its load-failure
   branch, so the post still finds a form and the page shows its own load error. *@
@if (_formName is not null)
{
    <form method="post" @formname="@_formName" @onsubmit="IgnoreSubmit" hidden></form>
}

@code {
    private string? _formName;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// A post that names any other form still gets Blazor's 400.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public Func<string, bool> IsPageForm { get; set; } = static _ => false;

    protected override void OnParametersSet()
    {
        _formName = PostedForm.NameOf(HttpContext) is { } postedName && IsPageForm(postedName)
            ? postedName
            : null;
    }

    private static void IgnoreSubmit()
    {
    }
}
