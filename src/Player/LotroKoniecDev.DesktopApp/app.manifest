<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Windows reads this manifest; Avalonia's own template ships it. Without the supportedOS entry
       Windows reports an older version to the process. -->
  <assemblyIdentity version="1.0.0.0" name="LotroPoPolsku.Desktop"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Admin rights once, at start (owner decision 2 on #42, carried out in #1464): a patch writes
             the game's DAT under Program Files. The app is then safe only because everything it reads
             or writes sits under its own folder, which only administrators can change (ADR-0069
             amendment of 2026-11-18). Any level here also keeps Windows from redirecting a 32-bit
             app's writes to the VirtualStore folder. -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
