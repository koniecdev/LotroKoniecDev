<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LotroKoniecDev.DesktopApp.Presentation.ViewModels"
        x:Class="LotroKoniecDev.DesktopApp.Presentation.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Ustawienia"
        Icon="/Assets/app.ico"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        CanMaximize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="Folder gry" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Name="GameFolderBox" Text="{Binding GameFolder}" />
                <Button Grid.Column="1" Name="BrowseGameFolderButton" Content="Przeglądaj…"
                        Command="{Binding BrowseGameFolderCommand}" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Własny plik polish.txt (opcjonalnie)" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Name="TranslationFileBox" Text="{Binding TranslationFile}" />
                <Button Grid.Column="1" Name="BrowseTranslationFileButton" Content="Przeglądaj…"
                        Command="{Binding BrowseTranslationFileCommand}" />
            </Grid>
        </StackPanel>

        <CheckBox Name="AutoPatchBox" Content="Nakładaj spolszczenie przy uruchamianiu gry"
                  IsChecked="{Binding AutoPatchOnLaunch}" />

        <StackPanel Spacing="4">
            <TextBlock Text="Adres serwera tłumaczeń" />
            <TextBox Name="ServerAddressBox" Text="{Binding ServerAddress}" />
            <TextBlock Text="Puste pole przywraca adres domyślny." FontSize="12" Opacity="0.7" />
        </StackPanel>

        <TextBlock Name="SettingsErrorText" Text="{Binding ErrorText}" IsVisible="{Binding IsErrorVisible}"
                   TextWrapping="Wrap" FontWeight="SemiBold" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <Button Grid.Column="0" Name="SaveSettingsButton" Content="Zapisz" Command="{Binding SaveCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" Name="CancelSettingsButton" Content="Anuluj" Command="{Binding CancelCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </Grid>
    </StackPanel>
</Window>
