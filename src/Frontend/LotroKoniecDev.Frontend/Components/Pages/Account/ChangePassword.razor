@page "/account/change-password"
@attribute [Authorize]
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Authorization
@using LotroKoniecDev.AuthSystem.Contracts.Features.Auth.Account
@using LotroKoniecDev.AuthSystem.Contracts.Hateoas
@using LotroKoniecDev.Frontend.Infrastructure.Hateoas
@using LotroKoniecDev.Frontend.Infrastructure.HttpClients
@using LotroKoniecDev.Hateoas.Abstractions
@using LotroKoniecDev.Frontend.Infrastructure.Errors
@inject AccountLoader Loader

<PageTitle>Zmień hasło — lotro-translator.pl</PageTitle>

<section class="container page-head">
    <div>
        <h1>Zmień hasło</h1>
        <p class="lede">Ustaw nowe hasło, potwierdzając operację obecnym hasłem.</p>
    </div>
</section>

<section class="container content-wrap">
    @if (_changed)
    {
        <div class="status-message status-success" role="status">
            <p>Hasło zostało zmienione.</p>
        </div>
        <a class="btn btn-primary" href="/account">Wróć do konta</a>
    }
    else if (_loadResult is null)
    {
        <div class="loading-indicator">
            <span class="li-spin"></span> Wczytywanie…
        </div>
    }
    else if (_loadResult.IsUnauthorized)
    {
        <RedirectToLogin/>
    }
    else if (_loadResult.IsFailure)
    {
        <div class="error-message" role="alert">
            <span class="em-ico" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
                    <path d="M12 9v4"/><path d="M12 17h.01"/>
                </svg>
            </span>
            <div class="em-body">
                <ApiProblemAlert Problem="@_loadResult.ProblemDetails"
                                 Fallback="Nie udało się wczytać danych konta."
                                 HeadlineClass="t"/>
            </div>
        </div>
    }
    else if (_changePasswordLink is null)
    {
        <div class="status-message status-warning" role="status">
            <p>Zmiana hasła jest w tej chwili niedostępna. Spróbuj ponownie później.</p>
        </div>
        <a class="btn btn-ghost" href="/account">Wróć do konta</a>
    }
    else
    {
        <section class="panel">
            <header class="panel-head">
                <h2>Nowe hasło</h2>
                <span class="panel-aside">Minimum @PasswordMinLength znaków</span>
            </header>
            <div class="panel-body">
                @if (_submitProblem is not null)
                {
                    <div class="error-message" role="alert">
                        <span class="em-ico" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
                                <path d="M12 9v4"/><path d="M12 17h.01"/>
                            </svg>
                        </span>
                        <div class="em-body">
                            <ApiProblemAlert Problem="@_submitProblem"
                                             Fallback="Nie udało się zmienić hasła."
                                             HeadlineClass="t"/>
                        </div>
                    </div>
                }

                <form method="post" @formname="change-password" @onsubmit="ChangeAsync" class="stacked-form">
                    <AntiforgeryToken/>
                    <div class="field">
                        <label for="current-password">
                            Obecne hasło
                        </label>
                        <input id="current-password" name="PasswordInput.CurrentPassword" type="password"
                               autocomplete="current-password"/>
                    </div>
                    <div class="field">
                        <label for="new-password">
                            Nowe hasło
                        </label>
                        <input id="new-password" name="PasswordInput.NewPassword" type="password"
                               autocomplete="new-password"/>
                        <p class="field-hint">Wymagania: @ApiProblemCopy.PasswordRules</p>
                    </div>
                    <div class="field">
                        <label for="repeat-password">
                            Powtórz nowe hasło
                        </label>
                        <input id="repeat-password" name="PasswordInput.RepeatPassword" type="password"
                               autocomplete="new-password"/>
                    </div>
                    <div class="form-actions">
                        <a class="btn btn-ghost" href="/account">Anuluj</a>
                        <button type="submit" class="btn btn-primary" data-testid="change-password-submit">Zmień hasło</button>
                    </div>
                </form>
            </div>
        </section>
    }
</section>

@code
{
    /// <summary>
    /// Repeats the auth API's <c>PasswordValidationRules</c> minimum of 8 for the panel heading. The
    /// server still decides; this is never enforced here beyond the text. The full rule list under the
    /// field comes from <see cref="ApiProblemCopy.PasswordRules"/>, so the hint and the failure message
    /// cannot drift apart.
    /// </summary>
    private const int PasswordMinLength = 8;

    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordFormModel? PasswordInput { get; set; }

    private ApiResult<AccountDataExportResponse>? _loadResult;
    private LinkDto? _changePasswordLink;
    private Microsoft.AspNetCore.Mvc.ProblemDetails? _submitProblem;
    private bool _changed;

    protected override async Task OnInitializedAsync()
    {
        // A property initializer is rejected for a [SupplyParameterFromForm] model (BL0008), so seed it
        // here instead.
        PasswordInput ??= new ChangePasswordFormModel();

        _loadResult = await Loader.LoadExportAsync(CancellationToken.None);
        if (_loadResult.IsSuccess)
        {
            _changePasswordLink = _loadResult.Value.Links.FindLink(Rels.ChangePassword);
        }
    }

    private async Task ChangeAsync()
    {
        _submitProblem = null;

        if (_changePasswordLink is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(PasswordInput?.CurrentPassword)
            || string.IsNullOrWhiteSpace(PasswordInput.NewPassword))
        {
            _submitProblem = ApiProblemCopy.FrontendAuthored(
                "Wypełnij wszystkie pola",
                "Obecne i nowe hasło są wymagane.");
            return;
        }

        if (!string.Equals(PasswordInput.NewPassword, PasswordInput.RepeatPassword, StringComparison.Ordinal))
        {
            _submitProblem = ApiProblemCopy.FrontendAuthored(
                "Hasła nie są zgodne",
                "Nowe hasło i jego powtórzenie muszą być identyczne.");
            return;
        }

        ApiResult result = await Loader.ChangePasswordAsync(
            _changePasswordLink.Href,
            PasswordInput.CurrentPassword,
            PasswordInput.NewPassword,
            CancellationToken.None);

        if (result.IsSuccess)
        {
            _changed = true;
            return;
        }

        if (result.IsUnauthorized)
        {
            _submitProblem = ApiProblemCopy.FrontendAuthored(
                "Sesja wygasła",
                "Zaloguj się ponownie, aby zmienić hasło.");
            return;
        }

        _submitProblem = result.ProblemDetails
                         ?? ApiProblemCopy.FrontendAuthored("Nie udało się zmienić hasła.");
    }

    public sealed class ChangePasswordFormModel
    {
        public string? CurrentPassword { get; set; }

        public string? NewPassword { get; set; }

        public string? RepeatPassword { get; set; }
    }
}
