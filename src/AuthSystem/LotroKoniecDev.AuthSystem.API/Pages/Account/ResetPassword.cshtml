@page
@model LotroKoniecDev.AuthSystem.API.Pages.Account.ResetPasswordModel
@using LotroKoniecDev.SharedKernel.Constants
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nowe hasło — lotro-translator.pl</title>
    <link rel="stylesheet" href="/fonts.css" />
    <link rel="stylesheet" href="/account.css" />
</head>
<body>
    <div class="app">
        <div class="auth-top">
            <a href="@FrontendHome.Url" class="brand">
                <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="1.1" fill="currentColor"/></svg></span>
                <span class="brand-text">lotro-<span class="brand-accent">translator</span>.pl</span>
            </a>
            <a href="/Account/Login" class="top-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="m10 17 5-5-5-5"/><path d="M15 12H3"/></svg><span>Zaloguj się</span></a>
        </div>

        <div class="auth-main">
            <div class="auth-stack">
                @if (Model.IsCompleted)
                {
                    <p class="auth-eyebrow">Bezpieczeństwo konta</p>
                    <section class="auth-panel" aria-labelledby="reset-h">
                        <header class="auth-panel-head">
                            <h2 id="reset-h">
                                <span class="panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
                                Nowe hasło
                            </h2>
                            <span class="panel-aside">Gotowe</span>
                        </header>
                        <div class="auth-panel-body">
                            <div class="auth-alert success" role="status" data-testid="reset-password-success">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                                <div>
                                    <span class="t">Hasło zmienione — zaloguj się</span>
                                    <span class="s">Twoje nowe hasło jest aktywne. Ze względów bezpieczeństwa unieważniliśmy pozostałe sesje — na innych urządzeniach wylogujemy Cię w ciągu kilku minut.</span>
                                </div>
                            </div>
                            <div class="auth-actions">
                                <a href="/Account/Login" class="btn btn-primary btn-block">
                                    Zaloguj się
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
                                </a>
                            </div>
                        </div>
                    </section>
                }
                else if (Model.TokenInvalid)
                {
                    <p class="auth-eyebrow danger">Bezpieczeństwo konta</p>
                    <section class="auth-panel" aria-labelledby="reset-h">
                        <header class="auth-panel-head">
                            <h2 id="reset-h">
                                <span class="panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
                                Nowe hasło
                            </h2>
                            <span class="panel-aside">Błąd</span>
                        </header>
                        <div class="auth-panel-body">
                            <div class="auth-alert" role="alert" data-testid="reset-password-error">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.86 1.82 18a2 2 0 0 0 1.7 3h16.94a2 2 0 0 0 1.7-3L13.69 3.86a2 2 0 0 0-3.4 0z"/></svg>
                                <div>
                                    <span class="t">Link resetu wygasł lub jest nieprawidłowy</span>
                                    <span class="s">Link do zmiany hasła można użyć tylko raz. Poproś o nowy link, aby kontynuować.</span>
                                </div>
                            </div>
                            <div class="auth-actions">
                                <a href="/Account/ForgotPassword" class="btn btn-primary btn-block">
                                    Poproś o nowy link
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v4h4"/></svg>
                                </a>
                                <a href="/Account/Login" class="btn btn-ghost btn-block">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m11 19-7-7 7-7"/></svg>
                                    Powrót do logowania
                                </a>
                            </div>
                        </div>
                    </section>
                }
                else
                {
                    <p class="auth-eyebrow">Bezpieczeństwo konta</p>
                    <section class="auth-panel" aria-labelledby="reset-h">
                        <header class="auth-panel-head">
                            <h2 id="reset-h">
                                <span class="panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
                                Nowe hasło
                            </h2>
                            <span class="panel-aside">Token OK</span>
                        </header>
                        <form class="auth-panel-body" method="post" data-submit-once data-recheck-when-restored>
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="Token" />
                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <div class="auth-alert" role="alert">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.86 1.82 18a2 2 0 0 0 1.7 3h16.94a2 2 0 0 0 1.7-3L13.69 3.86a2 2 0 0 0-3.4 0z"/></svg>
                                    <div>
                                        <span class="t">Nie udało się ustawić hasła</span>
                                        <span class="s">@Model.ErrorMessage</span>
                                    </div>
                                </div>
                            }
                            <p class="auth-lead">Ustal nowe hasło do swojego konta. Po zapisaniu zalogujesz się przy jego użyciu.</p>
                            <div class="auth-field">
                                <label asp-for="NewPassword">Nowe hasło</label>
                                <div class="auth-input-wrap">
                                    <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                                    @* No maxlength on purpose: a browser cuts a longer pasted password without a word, and a
                                       password manager then saves a password the account never got. The server refuses it
                                       and names the rule instead (#1046). *@
                                    <input asp-for="NewPassword" type="password" class="auth-input" placeholder="Minimum @PasswordConstants.MinLength znaków" autocomplete="new-password" required autofocus />
                                </div>
                            </div>
                            <div class="auth-field">
                                <label asp-for="ConfirmPassword">Powtórz nowe hasło</label>
                                <div class="auth-input-wrap">
                                    <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                                    <input asp-for="ConfirmPassword" type="password" class="auth-input" placeholder="Wpisz hasło ponownie" autocomplete="new-password" required />
                                </div>
                            </div>
                            <ul class="pw-rules" aria-label="Wymagania hasła">
                                <li><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>@(PasswordConstants.MinLength)–@(PasswordConstants.MaxLength) znaków</li>
                                <li><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Mała i wielka litera</li>
                                <li><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Cyfra</li>
                                <li><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Znak specjalny</li>
                            </ul>
                            <div class="auth-actions">
                                <button type="submit" class="btn btn-primary btn-block" data-testid="reset-password-submit" data-busy-label="Zapisywanie hasła…">
                                    <span class="spinner-sm" aria-hidden="true"></span>
                                    <span class="submit-btn-label">Ustaw nowe hasło</span>
                                    <svg class="submit-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
                                </button>
                            </div>
                        </form>
                    </section>
                }
                <p class="auth-meta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg> Połączenie szyfrowane · TLS 1.3</p>
            </div>
        </div>

        <footer class="foot">
            <p>lotro-translator.pl — niekomercyjny projekt społeczności polskich graczy LOTRO</p>
        </footer>
    </div>

    <script src="/submit-once.js"></script>
</body>
</html>
