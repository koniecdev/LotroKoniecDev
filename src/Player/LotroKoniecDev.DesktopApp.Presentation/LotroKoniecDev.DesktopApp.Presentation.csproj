<Project Sdk="Microsoft.NET.Sdk">
    <!-- Plain net10.0 on purpose (ADR-0033 §2): the platform analyzer then fails the build on a .NET API
         marked Windows-only, and the UI tests run on the Linux CI runner. Windows-only code lives in
         the exe. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="LotroKoniecDev.DesktopApp.Tests.Unit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Patcher\LotroKoniecDev.Application\LotroKoniecDev.Application.csproj" />
    </ItemGroup>
</Project>
