@page "/editor/{Id:guid}"
@attribute [Authorize]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc
@using LotroKoniecDev.Frontend.Components.Pages.Translations
@using LotroKoniecDev.Frontend.Infrastructure.Errors
@using LotroKoniecDev.Frontend.Infrastructure.Forms
@using LotroKoniecDev.Frontend.Infrastructure.Hateoas
@using LotroKoniecDev.Frontend.Infrastructure.HttpClients
@using LotroKoniecDev.Hateoas.Abstractions
@using LotroKoniecDev.TranslationSystem.Contracts.Common
@using LotroKoniecDev.TranslationSystem.Contracts.Hateoas
@using LotroKoniecDev.TranslationSystem.Contracts.Translations
@using LotroKoniecDev.TranslationSystem.Primitives.Aggregates.TranslationAggregate
@using LotroKoniecDev.TranslationSystem.Primitives.Constants
@using Microsoft.AspNetCore.WebUtilities
@inject TranslationEditorLoader Loader
@inject NavigationManager Navigation

<PageTitle>Edytor tłumaczenia — lotro-translator.pl</PageTitle>

<section class="container page-head">
    <div>
        <h1>Edytor tłumaczenia</h1>
        <p class="lede">
            Po lewej tekst angielski (do odczytu), po prawej Twoje tłumaczenie. Zachowaj znaczniki
            <code class="ph-token">@PlaceholderAnalyzer.Placeholder</code> w niezmienionej postaci.
        </p>
    </div>
    <div class="head-actions">
        <a class="btn btn-ghost" href="@_listQuery.ToListRelativeUri()">← Wróć do listy</a>
    </div>
</section>

<section class="container content-wrap">
    @if (_detail is null)
    {
        @if (_draftText is not null)
        {
            @* A save sent while the row could not be loaded still runs (#1122). When it fails, the typed
               text stays in a form that can be sent again. The hidden key fields survived the post. *@
            @if (_saveProblem is not null)
            {
                <div class="error-message" role="alert">
                    <span class="em-ico" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
                            <path d="M12 9v4"/><path d="M12 17h.01"/>
                        </svg>
                    </span>
                    <div class="em-body">
                        <ApiProblemAlert Problem="@_saveProblem"
                                         Fallback="Nie udało się zapisać tłumaczenia."
                                         HeadlineClass="t"/>
                    </div>
                </div>
            }
            <section class="panel">
                <header class="panel-head">
                    <h2>Tłumaczenie polskie</h2>
                    <span class="panel-aside">Wersja robocza</span>
                </header>
                <div class="panel-body">
                    <form method="post" @formname="@SaveFormName" @onsubmit="SaveAsync">
                        <AntiforgeryToken/>
                        <input type="hidden" name="FileIdField" value="@FileIdField"/>
                        <input type="hidden" name="GossipIdField" value="@GossipIdField"/>
                        <label class="visually-hidden" for="translated-recovery">Tłumaczenie polskie</label>
                        <textarea id="translated-recovery" name="DraftField" class="editor-textarea mono" rows="8"
                                  maxlength="@DatFormatConstants.MaxTranslatedTextLength"
                                  placeholder="Wpisz tłumaczenie…">@_draftText</textarea>
                        <div class="editor-actions" style="margin-top: 12px;">
                            <button type="submit" class="btn btn-primary">Zapisz ponownie</button>
                        </div>
                    </form>
                </div>
            </section>
        }
        else if (_loadProblem is not null)
        {
            @* The action happened even when the reload after its redirect fails, so the confirmation still
               shows (#1122). A post keeps the flag only because the address still has it, so it shows none. *@
            @if (_filledCount is { } filledAfterRedirect)
            {
                <div class="status-message status-success" role="status">
                    <p>@FilledLine(filledAfterRedirect)</p>
                </div>
            }
            else if (_postedFormName is null && Saved)
            {
                <div class="status-message status-success" role="status">
                    <p>Tłumaczenie zapisano.</p>
                </div>
            }
            @if (_postedFormName is null && Approved)
            {
                <div class="status-message status-success" role="status">
                    <p>Tłumaczenie zatwierdzono i dołączono do dystrybucji.</p>
                </div>
            }
            @NextRowLines()
            <div class="error-message" role="alert">
                <span class="em-ico" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
                        <path d="M12 9v4"/><path d="M12 17h.01"/>
                    </svg>
                </span>
                <div class="em-body">
                    <ApiProblemAlert Problem="@_loadProblem"
                                     Fallback="Nie udało się wczytać tłumaczenia."
                                     HeadlineClass="t"/>
                </div>
            </div>

            <PostedFormTarget IsPageForm="@(static formName => formName == ApproveFormName)"/>
        }
        else
        {
            <div class="loading-indicator">
                <span class="li-spin"></span> Wczytywanie tłumaczenia…
            </div>
        }
    }
    else
    {
        TranslationDetailResponse detail = _detail;
        PlaceholderComparison comparison = PlaceholderAnalyzer.Compare(detail.SourceText, _draftText ?? detail.TranslatedText);
        IReadOnlyList<TranslationSlip> slips = TranslationSlipChecker.Check(detail.SourceText, _draftText ?? detail.TranslatedText);

        <div class="results-meta">
            <span class="count">FileId <strong class="mono">@detail.FileId</strong></span>
            <span class="count">GossipId <strong class="mono">@detail.GossipId</strong></span>
            <span class="badge @TranslationStatusDisplay.BadgeClass(detail.Status)">
                <span class="dot"></span>@TranslationStatusDisplay.Label(detail.Status)
            </span>
        </div>

        @* A success flag stays in the URL after its redirect. It shows only on a GET, and it is hidden when the
           other action just failed, so a new error or a stop never sits next to an old confirmation. *@
        @if (_saveProblem is not null)
        {
            <div class="status-message status-error" role="alert">
                <ApiProblemAlert Problem="@_saveProblem" Fallback="Nie udało się zapisać tłumaczenia."/>
                @if (_fillOutcomeUnknown)
                {
                    <p>@UnknownOutcomeLine()</p>
                }
            </div>
        }
        else if (_filledCount is { } filled && _approveProblem is null)
        {
            <div class="status-message status-success" role="status">
                <p>@FilledLine(filled)</p>
            </div>
        }
        else if (_postedFormName is null && Saved && _approveProblem is null)
        {
            <div class="status-message status-success" role="status">
                <p>Tłumaczenie zapisano.</p>
            </div>
        }

        @if (_approveProblem is not null)
        {
            <div class="status-message status-error" role="alert">
                <ApiProblemAlert Problem="@_approveProblem" Fallback="Nie udało się zatwierdzić tłumaczenia."/>
            </div>
        }
        else if (_postedFormName is null && Approved && _saveProblem is null)
        {
            <div class="status-message status-success" role="status">
                <p>Tłumaczenie zatwierdzono i dołączono do dystrybucji.</p>
            </div>
        }

        @NextRowLines()

        @if (!comparison.IsMatch)
        {
            <div class="status-message status-warning" role="alert">
                <p>
                    Liczba znaczników się nie zgadza: w tekście angielskim @comparison.SourceCount,
                    w tłumaczeniu @comparison.TranslatedCount. Zachowaj każdy znacznik
                    <code class="ph-token">@PlaceholderAnalyzer.Placeholder</code>.
                </p>
            </div>
        }

        @* The fill checks the slips before it sends anything (owner decision of 2026-11-27 on #1587). The
           line sits right above the slips, which are drawn once. *@
        @if (_fillStop is not FillStop.None)
        {
            <div class="status-message status-warning fill-stop" role="alert">
                @if (_fillStop is FillStop.Slips && FillLink is not null)
                {
                    <p>Tekst nie jest jeszcze zapisany. Popraw go albo zapisz mimo to.</p>
                }
                else
                {
                    <p>Tekst nie jest jeszcze zapisany.</p>
                    @if (_fillStop is FillStop.Slips && _sameSourceText is not null)
                    {
                        <p>@NoEmptyRowLeftLine(detail)</p>
                    }
                }
            </div>
        }

        @* Only advice, so the save never waits for it (#1489). *@
        @if (slips.Count > 0)
        {
            <div class="status-message status-warning translation-slips" role="alert">
                @foreach (TranslationSlip slip in slips)
                {
                    <p>@slip.Message</p>
                }
            </div>
        }

        <div class="editor-grid">
            <section class="panel">
                <header class="panel-head">
                    <h2>Tekst angielski</h2>
                    <span class="panel-aside">Oryginał</span>
                </header>
                <div class="panel-body">
                    <div class="editor-source">@RenderHighlighted(detail.SourceText)</div>

                    @if (!string.IsNullOrEmpty(detail.PreviousSourceText))
                    {
                        <div class="editor-superseded">
                            <h3 class="editor-pane-subtitle">Poprzednia wersja angielska (do porównania)</h3>
                            <div class="editor-source is-superseded">@RenderHighlighted(detail.PreviousSourceText)</div>
                        </div>
                    }
                </div>
            </section>

            <section class="panel">
                <header class="panel-head">
                    <h2>Tłumaczenie polskie</h2>
                    <span class="panel-aside">Edycja</span>
                </header>
                <div class="panel-body">
                    @{
                        LinkDto? upsertLink = detail.Links.FindLink(Rels.Upsert);
                    }
                    @if (upsertLink is not null)
                    {
                        <form method="post" @formname="@SaveFormName" @onsubmit="SaveAsync">
                            <AntiforgeryToken/>
                            <input type="hidden" name="FileIdField" value="@detail.FileId"/>
                            <input type="hidden" name="GossipIdField" value="@detail.GossipId"/>
                            <label class="visually-hidden" for="translated">Tłumaczenie polskie</label>
                            <textarea id="translated" name="DraftField" class="editor-textarea mono" rows="8"
                                      maxlength="@DatFormatConstants.MaxTranslatedTextLength"
                                      placeholder="Wpisz tłumaczenie…">@TextareaContent(_draftText ?? detail.TranslatedText)</textarea>
                            @if (_place is not null)
                            {
                                @* What the field showed before any typing, so "Zapisz i następny" can tell an
                                   unchanged text (owner decision of 2026-11-25 on #1490). *@
                                <input type="hidden" name="ShownTextField" value="@(_postedShownText ?? detail.TranslatedText)"/>
                            }
                            <div class="editor-actions editor-save-actions" style="margin-top: 12px;">
                                <button type="submit" class="btn btn-primary">Zapisz</button>
                                @if (_place is not null)
                                {
                                    <button type="submit" class="btn btn-primary" name="SaveAction" value="@NextSaveAction">Zapisz i następny</button>
                                    <button type="submit" class="btn btn-ghost" name="SaveAction" value="@SkipSaveAction">Następny</button>
                                }
                                @if (FillLink is not null && _sameSourceText is { } fillPanel)
                                {
                                    <button type="submit" class="btn btn-primary editor-fill" name="SaveAction" value="@FillSaveAction">Zapisz we wszystkich identycznych (@fillPanel.EmptyIdenticalCount.ToString(CultureInfo.InvariantCulture))</button>
                                    @if (_fillStop is FillStop.Slips)
                                    {
                                        <button type="submit" class="btn btn-primary editor-fill" name="SaveAction" value="@FillAnywaySaveAction">Zapisz we wszystkich mimo to</button>
                                    }
                                }
                            </div>
                        </form>
                    }
                    else
                    {
                        <p class="text-dim">Ten wiersz jest tylko do odczytu.</p>
                    }

                    @if (detail.Links.HasLink(Rels.Approve))
                    {
                        <form method="post" @formname="@ApproveFormName" @onsubmit="ApproveAsync" class="editor-approve">
                            <AntiforgeryToken/>
                            <button type="submit" class="btn btn-ghost">Zatwierdź</button>
                        </form>
                    }
                </div>
            </section>
        </div>

        @if (_sameSourceTextFailed)
        {
            <div class="status-message status-warning same-source-unavailable" role="status">
                <p>Nie udało się wczytać innych wierszy z tym samym tekstem angielskim. Odśwież stronę, aby spróbować ponownie.</p>
            </div>
        }
        else if (_sameSourceText is { TotalCount: > 0 } sameSourceText)
        {
            <section class="panel same-source" aria-labelledby="same-source-title">
                <header class="panel-head">
                    <h2 id="same-source-title">Inne wiersze z tym samym tekstem</h2>
                    <span class="panel-aside">@sameSourceText.TotalCount</span>
                </header>
                <div class="panel-body">
                    @if (sameSourceText.HasConflictingTranslations)
                    {
                        <div class="status-message status-warning same-source-conflict" role="alert">
                            <p>Ten sam tekst angielski ma w różnych wierszach różne tłumaczenia polskie. Sprawdź, czy tak ma być.</p>
                        </div>
                    }
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th scope="col" class="col-num">FileId</th>
                                    <th scope="col" class="col-num">GossipId</th>
                                    <th scope="col">Tłumaczenie polskie</th>
                                    <th scope="col" class="col-status">Status</th>
                                    <th scope="col">Zapisane przez</th>
                                    <th scope="col" class="col-actions"><span class="visually-hidden">Akcje</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (SameSourceTextItemResponse other in sameSourceText.Items)
                                {
                                    <tr>
                                        <td class="col-num mono">@other.FileId</td>
                                        <td class="col-num mono">@other.GossipId</td>
                                        <td class="col-text">
                                            @if (string.IsNullOrEmpty(other.TranslatedText))
                                            {
                                                <span class="text-dim">—</span>
                                            }
                                            else
                                            {
                                                @other.TranslatedText
                                            }
                                        </td>
                                        <td class="col-status">
                                            <span class="badge @TranslationStatusDisplay.BadgeClass(other.Status)">
                                                <span class="dot"></span>@TranslationStatusDisplay.Label(other.Status)
                                            </span>
                                        </td>
                                        <td>@(other.Submitter?.DisplayName ?? "—")</td>
                                        <td class="col-actions">
                                            <a class="btn btn-ghost btn-sm" href="@OtherRowHref(other.Id)">Otwórz</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (sameSourceText.Items.Count < sameSourceText.TotalCount)
                    {
                        string? allRowsListHref = AllRowsListHref(detail.SourceText);
                        <p class="text-dim same-source-capped">
                            Pokazano @sameSourceText.Items.Count z @sameSourceText.TotalCount.
                            @if (allRowsListHref is not null)
                            {
                                <a class="same-source-all" href="@allRowsListHref">Pokaż wszystkie (@sameSourceText.TotalCount) na liście</a>
                            }
                            @if (sameSourceText.HasConflictingTranslations)
                            {
                                @if (allRowsListHref is not null)
                                {
                                    <span aria-hidden="true"> · </span>
                                }
                                <a class="same-source-conflict-link" href="@ConflictListHref(detail.SourceText)">Pokaż rozbieżne tłumaczenia na liście</a>
                            }
                        </p>
                    }
                </div>
            </section>
        }
    }
</section>

@code
{
    private const string SaveFormName = "save-translation";
    private const string ApproveFormName = "approve-translation";

    /// <summary>The value of the "Zapisz i następny" button; "Zapisz" sends none (spec 0018).</summary>
    private const string NextSaveAction = "next";

    /// <summary>The value of the "Następny" button, which opens the next row and never saves (#1585).</summary>
    private const string SkipSaveAction = "skip";

    /// <summary>The value of the fill button, which checks the slips first (#1587, spec 0019).</summary>
    private const string FillSaveAction = "fill";

    /// <summary>The fill after a slip stop: it fills the text as it stands.</summary>
    private const string FillAnywaySaveAction = "fill-anyway";

    private const string SaveBudgetExhaustedCode = "Translations.SaveBudgetExhausted";

    private const string SavedFlag = "saved";
    private const string ApprovedFlag = "approved";
    private const string PreviousSavedFlag = "previousSaved";
    private const string NextFailedFlag = "nextFailed";
    private const string FilledFlag = "filled";

    /// <summary>
    /// The capped panel's list links search for the English only up to this length, so the URL stays short.
    /// </summary>
    private const int MaxListSearchLength = 200;

    private TranslationDetailResponse? _detail;
    private SameSourceTextTranslationsResponse? _sameSourceText;
    private bool _sameSourceTextFailed;
    private ProblemDetails? _loadProblem;
    private ProblemDetails? _saveProblem;
    private ProblemDetails? _approveProblem;
    private string? _draftText;
    private string? _postedFormName;

    /// <summary>This row's place in the list it came from (#1490). Null when it did not come from the list.</summary>
    private string? _place;

    private string? _postedShownText;
    private bool _previousSaved;
    private bool _nextFailed;

    /// <summary>The rows the last fill wrote, from the address of its redirect; read only on a GET.</summary>
    private int? _filledCount;

    private FillStop _fillStop;
    private bool _fillOutcomeUnknown;

    /// <summary>A post reads the panel once: the fill before its write, any other post after it (#1482).</summary>
    private bool _sameSourceTextLoaded;

    /// <summary>
    /// The list state the editor's address carries, for every way back to the list (#1452). It has a value
    /// before the first render, because the page renders once while the row still loads.
    /// </summary>
    private TranslationListQuery _listQuery = TranslationListQuery.From(null, null, 1);

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = SaveFormName)]
    private string? DraftField { get; set; }

    [SupplyParameterFromForm(FormName = SaveFormName)]
    private int FileIdField { get; set; }

    [SupplyParameterFromForm(FormName = SaveFormName)]
    private long GossipIdField { get; set; }

    [SupplyParameterFromForm(FormName = SaveFormName)]
    private string? ShownTextField { get; set; }

    [SupplyParameterFromForm(FormName = SaveFormName)]
    private string? SaveAction { get; set; }

    /// <summary>
    /// Set by the redirect, so the confirmation needs no per-user state on the server (#321). A manual
    /// reload shows it again, which is harmless.
    /// </summary>
    [SupplyParameterFromQuery]
    private bool Saved { get; set; }

    [SupplyParameterFromQuery]
    private bool Approved { get; set; }

    [SupplyParameterFromQuery(Name = TranslationListQuery.PlaceName)]
    private string? Place { get; set; }

    /// <summary>
    /// Strings, so a value that is not a bool shows the page without the line instead of the error page.
    /// </summary>
    [SupplyParameterFromQuery(Name = PreviousSavedFlag)]
    private string? PreviousSaved { get; set; }

    [SupplyParameterFromQuery(Name = NextFailedFlag)]
    private string? NextFailed { get; set; }

    [SupplyParameterFromQuery(Name = FilledFlag)]
    private string? Filled { get; set; }

    /// <summary>The panel offers the fill only while an empty row with the same source exists (ADR-0040 amendment).</summary>
    private LinkDto? FillLink => _sameSourceText?.Links.FindLink(Rels.FillIdentical);

    protected override async Task OnParametersSetAsync()
    {
        _listQuery = TranslationListQuery.FromPageQuery(Navigation.Uri);
        _postedFormName = PostedForm.NameOf(HttpContext);
        _place = string.IsNullOrWhiteSpace(Place) ? null : Place;
        _postedShownText = _postedFormName == SaveFormName ? ShownTextField : null;

        // A post keeps the address and so its flags, so only a GET shows them (#1122).
        _previousSaved = _postedFormName is null && IsOn(PreviousSaved);
        _nextFailed = _postedFormName is null && IsOn(NextFailed);
        _filledCount = _postedFormName is null
                       && int.TryParse(Filled, NumberStyles.None, CultureInfo.InvariantCulture, out int filled)
            ? filled
            : null;

        ApiResult<TranslationDetailResponse> result = await Loader.LoadAsync(TranslationId.FromValue(Id), CancellationToken.None);
        if (result.IsSuccess)
        {
            _detail = result.Value;
            _loadProblem = null;

            // A post loads the panel in PostAsync, after its write, and only when it stays on the page.
            if (HttpContext is null || !HttpMethods.IsPost(HttpContext.Request.Method))
            {
                await LoadSameSourceTextAsync(result.Value);
            }
        }
        else
        {
            _detail = null;
            _loadProblem = result.ProblemDetails;
            _sameSourceText = null;
            _sameSourceTextFailed = false;

            // A save sent while the row cannot be loaded keeps its text, which draws the recovery form.
            if (_postedFormName == SaveFormName)
            {
                _draftText ??= DraftField ?? string.Empty;
            }
        }
    }

    private Task SaveAsync() =>
        PostAsync(SaveOrRedirectAsync);

    private Task ApproveAsync() =>
        PostAsync(ApproveOrRedirectAsync);

    /// <summary>
    /// Every form of this page posts through here. A good post redirects to a GET that loads the panel. A
    /// post that stays on the page loads it after its write, so a good post costs no extra request (#1482).
    /// The fill is the one post that reads the panel before its write, because its link lives there; that
    /// read is then the post's only one.
    /// </summary>
    private async Task PostAsync(Func<Task<bool>> postOrRedirect)
    {
        if (await postOrRedirect() || _detail is null || _sameSourceTextLoaded)
        {
            return;
        }

        await LoadSameSourceTextAsync(_detail);
    }

    /// <returns>
    /// <c>true</c> when the page redirects: after a good save, when "Zapisz i następny" moves on, and always
    /// after "Następny".
    /// </returns>
    private async Task<bool> SaveOrRedirectAsync()
    {
        // First, so "Następny" never reaches the save or any check before it (#1585). The typed text is
        // dropped, as "Wróć do listy" drops it. Without a place there is no next row, so the row shows again.
        if (SaveAction == SkipSaveAction)
        {
            if (_place is { } place)
            {
                await OpenNextRowAsync(place, saved: false);
            }
            else
            {
                Navigation.NavigateTo(EditorUriWithFlags());
            }

            return true;
        }

        if (SaveAction is FillSaveAction or FillAnywaySaveAction)
        {
            return await FillOrRedirectAsync(checkSlips: SaveAction == FillSaveAction);
        }

        _saveProblem = null;
        _draftText = DraftField ?? string.Empty;

        // Without a place there is no list to go on in, so "Zapisz i następny" is a plain save.
        string? nextRowPlace = SaveAction == NextSaveAction ? _place : null;
        if (nextRowPlace is not null && IsUnchanged(_draftText))
        {
            await OpenNextRowAsync(nextRowPlace, saved: false);
            return true;
        }

        ApiResult<string> upsertHref = await ResolveUpsertHrefAsync();
        if (upsertHref.IsFailure)
        {
            _saveProblem = upsertHref.ProblemDetails;
            return false;
        }

        UpsertTranslationRequest request = new(FileIdField, GossipIdField, _draftText);
        ApiResult<TranslationDetailResponse> result = await Loader.SaveAsync(upsertHref.Value, request, CancellationToken.None);

        if (result.IsSuccess)
        {
            // Warnings keep the translator on the row to fix the slip; a second press with no change moves on.
            if (nextRowPlace is not null
                && TranslationSlipChecker.Check(result.Value.SourceText, result.Value.TranslatedText).Count == 0)
            {
                await OpenNextRowAsync(nextRowPlace, saved: true);
                return true;
            }

            // A failure does not redirect, so the typed draft and the error stay on screen.
            Navigation.NavigateTo(EditorUriWithFlags(SavedFlag));
            return true;
        }

        _saveProblem = result.ProblemDetails;
        return false;
    }

    /// <returns><c>true</c> when the approve went through and the page redirects.</returns>
    private async Task<bool> ApproveOrRedirectAsync()
    {
        _approveProblem = null;

        // The API sends the approve rel only to an admin on a Draft or NeedsReview row, so its presence is
        // the whole check.
        LinkDto? approveLink = _detail?.Links.FindLink(Rels.Approve);
        if (approveLink is null)
        {
            return false;
        }

        ApiResult result = await Loader.ApproveAsync(approveLink.Href, CancellationToken.None);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(EditorUriWithFlags(ApprovedFlag));
            return true;
        }

        _approveProblem = result.ProblemDetails;
        return false;
    }

    /// <summary>
    /// The copy into every empty row with the same English (#1587, spec 0019). The slip check comes first
    /// and sends nothing. The href comes only from the panel read here, never from the post. With no empty
    /// row left, only this row can change, as the API would do it.
    /// </summary>
    /// <returns><c>true</c> when the fill went through and the page redirects.</returns>
    private async Task<bool> FillOrRedirectAsync(bool checkSlips)
    {
        _saveProblem = null;
        _draftText = DraftField ?? string.Empty;

        if (_detail is null)
        {
            _saveProblem = ApiProblemCopy.FrontendAuthored(
                "Tekst nie jest jeszcze zapisany.",
                "Nie udało się wczytać wiersza, więc nie wypełniono żadnego wiersza. „Zapisz ponownie” zapisze tylko ten wiersz.");
            return false;
        }

        if (checkSlips && TranslationSlipChecker.Check(_detail.SourceText, _draftText).Count > 0)
        {
            _fillStop = FillStop.Slips;
            return false;
        }

        await LoadSameSourceTextAsync(_detail);
        if (_sameSourceText is not { } panel)
        {
            _fillStop = FillStop.PanelFailed;
            return false;
        }

        if (FillLink is not { } fillLink)
        {
            return await SaveWithNoEmptyRowLeftAsync(_detail);
        }

        ApiResult<FillIdenticalTranslationsResponse> result = await Loader.FillIdenticalAsync(
            fillLink.Href, new FillIdenticalTranslationsRequest(_draftText), CancellationToken.None);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(FilledUri(result.Value.TranslationSaved, result.Value.FilledCount));
            return true;
        }

        _saveProblem = FillProblem(result.ProblemDetails, panel.EmptyIdenticalCount);
        if (IsOutcomeUnknown(result.ProblemDetails))
        {
            // The rows may be saved already, so the panel shows them as they are now.
            _fillOutcomeUnknown = true;
            await LoadSameSourceTextAsync(_detail);
        }

        return false;
    }

    /// <summary>
    /// The ticket's rule for a fill with no empty row left (spec 0019): this row is saved only when its text
    /// changed, through the plain save, which writes what the fill would. An unchanged text writes nothing, so
    /// an approved row stays approved and spends no overwrite.
    /// </summary>
    private async Task<bool> SaveWithNoEmptyRowLeftAsync(TranslationDetailResponse detail)
    {
        if (IsStoredText(detail, _draftText!))
        {
            Navigation.NavigateTo(FilledUri(saved: false, filled: 0));
            return true;
        }

        ApiResult<string> upsertHref = await ResolveUpsertHrefAsync();
        if (upsertHref.IsFailure)
        {
            _saveProblem = upsertHref.ProblemDetails;
            return false;
        }

        ApiResult<TranslationDetailResponse> result = await Loader.SaveAsync(
            upsertHref.Value, new UpsertTranslationRequest(detail.FileId, detail.GossipId, _draftText!), CancellationToken.None);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(FilledUri(saved: true, filled: 0));
            return true;
        }

        _saveProblem = result.ProblemDetails;
        return false;
    }

    /// <summary>
    /// Never an href that came with the post: a changed post could send the request, and its token, to another
    /// host. The upsert rel always points at the collection PUT, so when the row cannot give it, the service
    /// document does (#610). The server still decides on the request.
    /// </summary>
    private async Task<ApiResult<string>> ResolveUpsertHrefAsync() =>
        _detail?.Links.FindLink(Rels.Upsert)?.Href is { } upsertHref
            ? ApiResult.Success(upsertHref)
            : await Loader.ResolveCollectionUpsertHrefAsync(CancellationToken.None);

    private string FilledUri(bool saved, int filled) =>
        QueryHelpers.AddQueryString(
            saved ? EditorUriWithFlags(SavedFlag) : EditorUriWithFlags(),
            FilledFlag,
            filled.ToString(CultureInfo.InvariantCulture));

    /// <summary>
    /// Redirect after post (#321): a reload is a plain GET, and the fresh load shows the server's new
    /// links, such as the approve button after a save. It keeps the list state, the place and only its own
    /// flags.
    /// </summary>
    private string EditorUriWithFlags(params ReadOnlySpan<string> flags)
    {
        string uri = _listQuery.ToEditorRelativeUri(TranslationId.FromValue(Id), _place);
        foreach (string flag in flags)
        {
            uri = QueryHelpers.AddQueryString(uri, flag, "true");
        }

        return uri;
    }

    /// <summary>
    /// "Unchanged" compares the field with the text the form showed, not with the stored text, so a double
    /// click or someone else's newer save never turns a pass into a save (owner decision of 2026-11-25 on
    /// #1490). Both sides get the save's trimming for this English; without the row the English is unknown,
    /// so they must match exactly. A blank shown text is an untranslated row, whose empty field still goes to
    /// the save and its refusal.
    /// </summary>
    private bool IsUnchanged(string typedText)
    {
        string? shownText = ShownTextField;
        if (string.IsNullOrWhiteSpace(shownText))
        {
            return false;
        }

        return _detail is null
            ? string.Equals(typedText, shownText, StringComparison.Ordinal)
            : string.Equals(
                TrailingLineBreaks.RemoveFrom(typedText, _detail.SourceText),
                TrailingLineBreaks.RemoveFrom(shownText, _detail.SourceText),
                StringComparison.Ordinal);
    }

    /// <summary>
    /// Opens the first row after this row's place, or the list after the last row (spec 0018). The API names
    /// the page, so "Wróć do listy" on the next row opens the right one. When the rows cannot be read, the
    /// translator stays here and can press again.
    /// </summary>
    private async Task OpenNextRowAsync(string place, bool saved)
    {
        ApiResult<PaginationResponse<TranslationListItemResponse>> rowsAfter =
            await Loader.LoadRowsAfterAsync(_listQuery, place, CancellationToken.None);
        if (rowsAfter.IsFailure)
        {
            Navigation.NavigateTo(saved
                ? EditorUriWithFlags(SavedFlag, NextFailedFlag)
                : EditorUriWithFlags(NextFailedFlag));
            return;
        }

        TranslationListQuery nextRowList = _listQuery.AtPage(rowsAfter.Value.Page);
        if (rowsAfter.Value.Items.FirstOrDefault() is { } nextRow)
        {
            string nextRowUri = nextRowList.ToEditorRelativeUri(nextRow.Id, nextRow.Place);
            Navigation.NavigateTo(saved ? QueryHelpers.AddQueryString(nextRowUri, PreviousSavedFlag, "true") : nextRowUri);
            return;
        }

        Navigation.NavigateTo(nextRowList.ToListRelativeUriWithLastRowNote(saved));
    }

    /// <summary>
    /// Its own state, so a failed panel never hides the row (#1347).
    /// </summary>
    private async Task LoadSameSourceTextAsync(TranslationDetailResponse detail)
    {
        _sameSourceText = null;
        _sameSourceTextFailed = false;
        _sameSourceTextLoaded = true;

        string? sameSourceTextHref = detail.Links.FindLink(Rels.SameSourceText)?.Href;
        if (sameSourceTextHref is null)
        {
            return;
        }

        ApiResult<SameSourceTextTranslationsResponse> result =
            await Loader.LoadSameSourceTextAsync(sameSourceTextHref, CancellationToken.None);
        if (result.IsSuccess)
        {
            _sameSourceText = result.Value;
        }
        else
        {
            _sameSourceTextFailed = true;
        }
    }

    /// <summary>
    /// Another row is a detour from the same list, so it keeps the list state for the way back.
    /// </summary>
    private string OtherRowHref(TranslationId id) =>
        _listQuery.ToEditorRelativeUri(id);

    /// <summary>
    /// The list's conflict filter is the uncapped view of these rows. The list's search also finds other rows
    /// (a longer text that contains this one, or an id: docs/API.md), so the list can show conflict rows of
    /// other texts too. When <see cref="ListSearchFor"/> returns null, the link opens the whole conflict list.
    /// </summary>
    private static string ConflictListHref(string sourceText) =>
        TranslationListQuery
            .From(ListSearchFor(sourceText), status: null, page: 1, conflictsOnly: true)
            .ToPageRelativeUri(1);

    /// <summary>
    /// Every row with this English, past the panel's cap (#1492). The "Cały tekst" search ignores case and a
    /// grammar mark, and it also matches the Polish and the ids (docs/API.md), so the list can show more rows.
    /// Like the conflict link, it opens a new list. When <see cref="ListSearchFor"/> returns null there is no
    /// link, because a list with no search shows every row.
    /// </summary>
    private static string? AllRowsListHref(string sourceText) =>
        ListSearchFor(sourceText) is { } search
            ? TranslationListQuery
                .From(search, status: null, page: 1, match: TranslationSearchMatch.WholeText)
                .ToPageRelativeUri(1)
            : null;

    /// <summary>
    /// The English as a list search term, or null when it cannot be one: it is blank, it is too long, or it
    /// has a line break. The list's search box drops a line break inside the text on the next submit.
    /// </summary>
    private static string? ListSearchFor(string sourceText) =>
        !string.IsNullOrWhiteSpace(sourceText)
        && sourceText.Length <= MaxListSearchLength
        && sourceText.IndexOfAny(['\r', '\n']) < 0
            ? sourceText
            : null;

    /// <summary>The limit answer names the copy, so the translator knows the row alone may still fit (spec 0019).</summary>
    private static ProblemDetails? FillProblem(ProblemDetails? problem, int emptyRows) =>
        problem is not null && ApiProblemCopy.ReadErrorCode(problem) == SaveBudgetExhaustedCode
            ? ApiProblemCopy.FrontendAuthored(
                $"Kopia do {RowsGenitive(emptyRows)} nie mieści się w dziennym limicie zapisów. Sam ten wiersz możesz zapisać przyciskiem „Zapisz”.",
                status: StatusCodes.Status429TooManyRequests)
            : problem;

    /// <summary>
    /// A server error or a timeout can come after the commit. Only a failure the website knows never left (an
    /// open circuit breaker, a connection that was never made) is known to have changed nothing.
    /// </summary>
    private static bool IsOutcomeUnknown(ProblemDetails? problem) =>
        problem?.Status is >= StatusCodes.Status500InternalServerError
        && !ApiProblemCopy.WasNeverSent(problem);

    /// <summary>The panel sentence only when the panel read after the failure worked.</summary>
    private string UnknownOutcomeLine() =>
        _sameSourceText is not null
            ? "Nie wiadomo, czy tekst zapisano. Panel niżej pokazuje wiersze po tej próbie."
            : "Nie wiadomo, czy tekst zapisano.";

    /// <summary>„Zapisz” is advice only for a changed text: on an unchanged approved row it would make a draft.</summary>
    private string NoEmptyRowLeftLine(TranslationDetailResponse detail) =>
        IsStoredText(detail, _draftText ?? string.Empty)
            ? "Nie ma już pustych wierszy z tym samym tekstem angielskim."
            : "Nie ma już pustych wierszy z tym samym tekstem angielskim. Ten wiersz zapiszesz przyciskiem „Zapisz”.";

    /// <summary>
    /// "Unchanged" as the API decides it for the fill: the typed text, trimmed as the save trims it, is the
    /// stored Polish.
    /// </summary>
    private static bool IsStoredText(TranslationDetailResponse detail, string typedText) =>
        detail.TranslatedText is not null
        && string.Equals(
            TrailingLineBreaks.RemoveFrom(typedText, detail.SourceText),
            detail.TranslatedText,
            StringComparison.Ordinal);

    private string FilledLine(int filled) =>
        (Saved, filled) switch
        {
            (true, 0) => "Tłumaczenie zapisano. Nie było już pustych wierszy z tym samym tekstem angielskim.",
            (false, 0) => "Nie było już pustych wierszy z tym samym tekstem angielskim. Ten wiersz już miał ten tekst, więc nic nie zapisano.",
            (true, _) => $"Tłumaczenie zapisano. Ten sam tekst wpisano też {InEmptyRows(filled)} z tym samym angielskim tekstem.",
            (false, _) => $"Ten sam tekst wpisano {InEmptyRows(filled)} z tym samym angielskim tekstem. Ten wiersz już go miał, więc się nie zmienił."
        };

    private static string InEmptyRows(int count) =>
        count == 1 ? "w 1 pustym wierszu" : string.Create(CultureInfo.InvariantCulture, $"w {count} pustych wierszach");

    private static string RowsGenitive(int count) =>
        count == 1 ? "1 wiersza" : string.Create(CultureInfo.InvariantCulture, $"{count} wierszy");

    private static bool IsOn(string? flag) => bool.TryParse(flag, out bool isOn) && isOn;

    /// <summary>
    /// The browser drops one line break right after the <c>&lt;textarea&gt;</c> start tag. This one goes, so
    /// a text that starts with a line break keeps it and an untouched field equals the stored text (spec 0018).
    /// </summary>
    private static string TextareaContent(string? text) => "\n" + text;

    /// <summary>The lines after "Zapisz i następny" and "Następny" (spec 0018). Their flags are read only on a GET.</summary>
    private RenderFragment NextRowLines() =>
        @<text>
            @if (_previousSaved)
            {
                <div class="status-message status-success" role="status">
                    <p>Poprzednie tłumaczenie zapisano.</p>
                </div>
            }
            @if (_nextFailed)
            {
                <div class="status-message status-warning" role="status">
                    <p>Nie udało się otworzyć następnego wiersza. Spróbuj jeszcze raz albo wróć do listy.</p>
                </div>
            }
        </text>;

    private static RenderFragment RenderHighlighted(string text) => builder =>
    {
        int sequence = 0;
        foreach (PlaceholderSegment segment in PlaceholderAnalyzer.Segment(text))
        {
            if (segment.IsPlaceholder)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "ph-token");
                builder.AddContent(sequence++, segment.Text);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(sequence++, segment.Text);
            }
        }
    };

    private enum FillStop
    {
        None,

        /// <summary>The typed text has slips, so the fill sent nothing.</summary>
        Slips,

        /// <summary>The panel could not be read, so the fill has no link to post to.</summary>
        PanelFailed
    }
}
