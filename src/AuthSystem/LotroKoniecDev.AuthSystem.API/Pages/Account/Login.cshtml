@page
@model LotroKoniecDev.AuthSystem.API.Pages.Account.LoginModel
@{
    Layout = null;
    string registerUrl = string.IsNullOrEmpty(Model.ReturnUrl)
        ? "/Account/Register"
        : $"/Account/Register?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}";
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zaloguj się — lotro-translator.pl</title>
    <link rel="stylesheet" href="/fonts.css" />
    <link rel="stylesheet" href="/account.css" />
</head>
<body class="page-login">
    <div class="app">
        <header class="auth-brand-strip">
            <div class="container">
                <a href="@FrontendHome.Url" class="brand">
                    <span class="brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="8.5"/>
                            <circle cx="12" cy="12" r="1.1" fill="currentColor"/>
                        </svg>
                    </span>
                    <span>lotro-<span class="brand-accent">translator</span>.pl</span>
                </a>
            </div>
        </header>

        <section class="container">
            <div class="auth-wrap">
                <div class="auth-intro">
                    <div>
                        <p class="eyebrow">DOSTĘP DO KONTA</p>
                        <h1>Zaloguj się do lotro-translator.pl</h1>
                    </div>
                    <p class="lede">Zaloguj się, aby tłumaczyć teksty gry, przeglądać postępy i zatwierdzać gotowe wpisy.</p>
                    <ul class="auth-perks">
                        <li>
                            <span class="ico">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 20h9"/>
                                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                                </svg>
                            </span>
                            <span class="copy">
                                Tłumacz teksty gry
                                <span class="sub">Edytor z podglądem angielskiego oryginału</span>
                            </span>
                        </li>
                        <li>
                            <span class="ico">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M3 3v18h18"/>
                                    <path d="M7 15v3"/>
                                    <path d="M12 10v8"/>
                                    <path d="M17 6v12"/>
                                </svg>
                            </span>
                            <span class="copy">
                                Śledź postęp tłumaczenia
                                <span class="sub">Filtry, statusy i obieg zatwierdzania</span>
                            </span>
                        </li>
                        <li>
                            <span class="ico">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="4" width="18" height="16" rx="2"/>
                                    <path d="M3 9h18"/>
                                    <path d="m8 14 3 3 5-6"/>
                                </svg>
                            </span>
                            <span class="copy">
                                Twoje dane pod kontrolą
                                <span class="sub">Eksport i usunięcie konta zgodne z RODO</span>
                            </span>
                        </li>
                    </ul>
                </div>

                <div>
                    <section class="auth-panel" aria-labelledby="auth-h">
                        <header class="auth-panel-head">
                            <h2 id="auth-h">
                                Logowanie
                            </h2>
                            <span class="panel-aside">E-mail + hasło</span>
                        </header>

                        @* The return target rides in a hidden field, not in the form action: an asp-route-*
                           value is a raw write that CodeQL reads as an XSS sink (#681). The field is
                           hand-rolled rather than asp-for because the handler sets ReturnUrl after checking
                           it, so there is no bound property to render. *@
                        <form id="login-form" method="post" class="auth-panel-body" data-submit-once>
                            @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                            {
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            }
                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <div class="auth-alert" role="alert" aria-live="assertive">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 9v4"/>
                                        <path d="M12 17h.01"/>
                                        <path d="M10.3 3.86 1.82 18a2 2 0 0 0 1.7 3h16.94a2 2 0 0 0 1.7-3L13.69 3.86a2 2 0 0 0-3.4 0z"/>
                                    </svg>
                                    <div>
                                        <span class="t">Nie udało się zalogować</span>
                                        <span class="s">@Model.ErrorMessage</span>
                                        @if (Model.ResendConfirmationEmail is { } resendConfirmationEmail)
                                        {
                                            <a class="alert-action"
                                               href="/Account/ResendConfirmation?email=@Uri.EscapeDataString(resendConfirmationEmail)">Wyślij link ponownie →</a>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="auth-field">
                                <div class="auth-field-row">
                                    <label asp-for="Email">Adres e-mail</label>
                                </div>
                                <div class="auth-input-wrap">
                                    <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect x="3" y="5" width="18" height="14" rx="2"/>
                                        <path d="m3 7 9 6 9-6"/>
                                    </svg>
                                    <input asp-for="Email"
                                           type="email"
                                           class="auth-input"
                                           placeholder="np. kasia@example.com"
                                           autocomplete="username"
                                           required
                                           autofocus />
                                </div>
                            </div>

                            <div class="auth-field">
                                <div class="auth-field-row">
                                    <label asp-for="Password" for="password-input">Hasło</label>
                                    <a href="/Account/ForgotPassword" class="hint-link">Nie pamiętam hasła →</a>
                                </div>
                                <div class="auth-input-wrap">
                                    <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect x="4" y="11" width="16" height="10" rx="2"/>
                                        <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
                                    </svg>
                                    <input id="password-input"
                                           asp-for="Password"
                                           type="password"
                                           class="auth-input has-trailing"
                                           placeholder="••••••••"
                                           autocomplete="current-password"
                                           required />
                                    <button type="button"
                                            id="password-toggle"
                                            class="auth-input-trailing"
                                            aria-label="Pokaż hasło"
                                            aria-pressed="false"
                                            aria-controls="password-input"
                                            tabindex="-1">
                                        <svg id="password-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <div class="auth-row-meta">
                                <label class="checkbox">
                                    <input asp-for="RememberMe" type="checkbox" />
                                    <span class="box">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M20 6 9 17l-5-5"/>
                                        </svg>
                                    </span>
                                    <span>Zapamiętaj mnie na tym urządzeniu</span>
                                </label>
                            </div>

                            <button id="submit-btn" type="submit" class="btn btn-primary auth-submit" data-busy-label="Logowanie…">
                                <span class="spinner-sm" aria-hidden="true"></span>
                                <span class="submit-btn-label">Zaloguj się</span>
                                <svg class="submit-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14"/>
                                    <path d="m13 5 7 7-7 7"/>
                                </svg>
                            </button>
                        </form>
                    </section>

                    <p class="auth-switch">Nie masz jeszcze konta? <a href="@registerUrl">Zarejestruj się →</a></p>
                    <p class="auth-switch">Nie dostałeś linku aktywacyjnego? <a href="/Account/ResendConfirmation">Wyślij ponownie →</a></p>

                    <div class="auth-meta">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="4" y="11" width="16" height="10" rx="2"/>
                            <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
                        </svg>
                        Połączenie szyfrowane · TLS 1.3
                    </div>
                </div>
            </div>
        </section>

        <footer class="foot">
            <p>lotro-translator.pl — niekomercyjny projekt społeczności polskich graczy LOTRO</p>
        </footer>
    </div>

    <script src="/login.js"></script>
    <script src="/submit-once.js"></script>
</body>
</html>
