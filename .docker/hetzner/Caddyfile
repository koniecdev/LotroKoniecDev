# Reverse proxy for the Hetzner deployment stack (compose.hetzner.yaml, ADR-0034).
#
# Same one-origin-per-app topology as the parity stack, but with REAL certificates: Caddy does
# ACME (Let's Encrypt) for the three public hostnames, which it can only do once the DNS A
# records point at this box — DNS first, ACME self-heals on retry (migration plan gotchas).
# TLS terminates here; the apps get plain HTTP on :8080 with X-Forwarded-* set (M6-02).
#
# The domains come from the per-box env file via compose (DOMAIN_APP/DOMAIN_AUTH/DOMAIN_TMS),
# so this one file serves prod and staging unchanged.

{
	email {$ACME_EMAIL}
}

# SEO crawler control (#531): every LOTRO vhost stamps X-Robots-Tag from the per-box XROBOTS env
# var — prod keeps the `all` default (an explicit no-op), the staging box sets `noindex, nofollow`
# in /opt/lotro/.env so the deliberately-public staging trio never gets indexed as duplicate
# content of prod. Deliberately NOT imported into the TKS vhosts below: TKS stamps the header
# app-side (koniecdev/TheKittySaver#390), and a Caddy-level set would override it.
(seo_headers) {
	header X-Robots-Tag "{$XROBOTS:all}"
}

{$DOMAIN_APP} {
	import seo_headers
	reverse_proxy frontend:8080
}

{$DOMAIN_AUTH} {
	import seo_headers
	reverse_proxy auth-api:8080
}

{$DOMAIN_TMS} {
	import seo_headers
	reverse_proxy tms-api:8080
}

# --- TheKittySaver (its stack lives in /opt/tks and joins the segregated `${project}_tks` network
# this Caddy also sits on — #506; this Caddy terminates TLS for its hostnames too). Caddy resolves
# these `tks-*` keys via the tks network and our own `frontend`/`auth-api`/`tms-api` via the default
# network, so the two stacks share only Caddy. The TKS_DOMAIN_* values come from the per-box env
# file; a box without the TKS stack keeps the compose defaults (*.localhost — internal cert,
# no ACME, requests just 502) so this file stays valid everywhere.
{$TKS_DOMAIN_APP} {
	reverse_proxy tks-frontend:8080
}

{$TKS_DOMAIN_API} {
	reverse_proxy tks-adoption-api:8080
}

# --- Observability ingest (ADR-0050 §4; #755 / koniecdev/TheKittySaver#599). The backend of the shared
# Grafana stack runs in /opt/obs on the STAGING box (ADR-0050 §1), so the prod box's agent has to
# cross a box boundary to reach it. This vhost is that route, and it is deliberately narrow:
#   * exactly three paths exist — the Loki push, the Prometheus remote-write, and the OTLP trace
#     gRPC method (the only one Tempo's receiver speaks, hence h2c);
#   * each is admitted only from ONE source address (the other box's static public IP, as a /32)
#     AND with one basic-auth credential. The two gates fail differently, and both are useful when
#     reading a log: an unadmitted SOURCE never matches the route at all and gets the plain 404 the
#     rest of the vhost serves — the push paths do not exist for it — while an admitted source with
#     a wrong credential gets Caddy's own 401. Neither reaches a backend container.
# Nothing else is served here: Grafana stays on loopback behind an ssh tunnel (runbook). A box
# without the backend keeps the compose defaults — an inert `obs.localhost` site whose push routes
# admit loopback only.
{$DOMAIN_OBS} {
	# Explicit, never `import seo_headers`: that snippet reads XROBOTS, which is `all` on prod.
	header X-Robots-Tag "noindex, nofollow"

	@push {
		remote_ip {$OBS_ALLOWED_PUSH_IP}
		path /loki/api/v1/push /api/v1/write /opentelemetry.proto.collector.trace.v1.TraceService/*
	}
	handle @push {
		basic_auth {
			{$OBS_PUSH_USER} {$OBS_PUSH_PASSWORD_HASH}
		}
		handle /loki/api/v1/push {
			reverse_proxy loki:3100
		}
		handle /api/v1/write {
			reverse_proxy prometheus:9090
		}
		handle /opentelemetry.proto.collector.trace.v1.TraceService/* {
			reverse_proxy h2c://tempo:4317
		}
	}
	handle {
		respond 404
	}
}
