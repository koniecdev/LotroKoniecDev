@inherits LayoutComponentBase
@using LotroKoniecDev.Frontend.Infrastructure.Auth.DeadSession
@using LotroKoniecDev.Frontend.Infrastructure.Formatting
@using LotroKoniecDev.Frontend.Settings
@using Microsoft.Extensions.Options
@inject ISessionExpiryNotice SessionExpiryNotice
@inject IOptions<AuthSystemSettings> AuthSystemOptions

<div class="app">
    <NavMenu/>

    @if (_showSessionExpiredNotice)
    {
        <div class="container" style="padding-top: 16px;">
            <div class="status-message status-warning" role="status">
                <p>Twoja sesja wygasła. Zaloguj się ponownie, aby kontynuować.</p>
            </div>
        </div>
    }

    <main>
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <div class="container" style="padding-top: 72px; padding-bottom: 72px;">
                    <div class="status-message status-error" role="alert">
                        <p>Wystąpił nieoczekiwany błąd. Odśwież stronę lub spróbuj ponownie później.</p>
                    </div>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <footer class="foot">
        <div class="container">
            <div class="foot-grid">
                <div class="foot-about">
                    <p class="foot-brand">lotro-translator.pl</p>
                    <p>Polskie tłumaczenie The Lord of the Rings Online.</p>
                    <p>Projekt open source — .NET 10 · Blazor SSR · PostgreSQL</p>
                </div>
                <div class="foot-column">
                    <p class="foot-heading">Projekt</p>
                    <ul class="foot-links">
                        <li><a href="@ExternalLinks.Repository" target="_blank" rel="noopener">GitHub</a></li>
                        <li><a href="@ExternalLinks.Discord" target="_blank" rel="noopener">Discord</a></li>
                    </ul>
                </div>
                <div class="foot-column">
                    <p class="foot-heading">Informacje</p>
                    <ul class="foot-links">
                        <li><a href="/regulamin">Regulamin</a></li>
                        <li><a href="@PrivacyPolicyUrl" target="_blank" rel="noopener">Polityka prywatności</a></li>
                    </ul>
                </div>
            </div>
            <div class="foot-notes">
                <p class="foot-legal">Nieoficjalny, niekomercyjny projekt fanowski — niepowiązany ze Standing Stone Games ani Middle-earth Enterprises. The Lord of the Rings Online™ oraz nazwy postaci, przedmiotów, wydarzeń i miejsc są znakami towarowymi Middle-earth Enterprises, LLC.</p>
                @* LEGAL-12 (a): on every page since #1575 (spec 0011). *@
                <p class="risk-note">Spolszczenie modyfikuje pliki gry — formalnie regulamin LOTRO nie przewiduje takich modyfikacji, choć przez ponad dekadę działania analogicznych projektów (rosyjskiego i hiszpańskiego) nie odnotowano za nie banów. Korzystasz na własną odpowiedzialność. Szczegóły w <a href="/regulamin">regulaminie</a>.</p>
            </div>
            <div class="foot-bottom">
                <p>© @DateTimeOffset.UtcNow.ToPolandTime().Year lotro-translator.pl</p>
                <p class="foot-credit">Logo i grafiki: MoFin</p>
            </div>
        </div>
    </footer>

    <CookieConsent/>
</div>

@code {
    private bool _showSessionExpiredNotice;

    private string PrivacyPolicyUrl =>
        $"{AuthSystemOptions.Value.BaseUrl.TrimEnd('/')}/Account/PrivacyPolicy";

    // Consumed at render time, so the banner shows once after a forced logout.
    protected override void OnInitialized() => _showSessionExpiredNotice = SessionExpiryNotice.Consume();
}
