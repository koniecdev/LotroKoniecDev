<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LotroKoniecDev.DesktopApp.Presentation.ViewModels"
        x:Class="LotroKoniecDev.DesktopApp.Presentation.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="LOTRO po Polsku"
        Icon="/Assets/app.ico"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" Spacing="20">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" />
            <TextBlock Grid.Row="0" Grid.Column="1" Name="StatusText" Text="{Binding Status}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Game version:" />
            <TextBlock Grid.Row="1" Grid.Column="1" Name="GameVersionText" Text="{Binding GameVersion}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Patch version:" />
            <TextBlock Grid.Row="2" Grid.Column="1" Name="PatchVersionText" Text="{Binding PatchVersion}" />
        </Grid>

        <!-- The first run (#43): hidden while a saved folder holds the game. -->
        <StackPanel Name="GameFolderPanel" Spacing="8" IsVisible="{Binding GameFolder.IsPanelVisible}">
            <TextBlock Name="GameFolderPromptText" Text="{Binding GameFolder.PromptText}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="{Binding GameFolder.IsQuestionVisible}">
                <Button Grid.Column="0" Name="ConfirmGameFolderButton" Content="Tak"
                        Command="{Binding GameFolder.ConfirmCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Grid.Column="1" Name="DeclineGameFolderButton" Content="Nie"
                        Command="{Binding GameFolder.DeclineCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </Grid>
            <!-- A scan can find many copies (backups, a second drive), so the list scrolls. -->
            <ScrollViewer Name="GameFolderCandidatesScroller" MaxHeight="260"
                          IsVisible="{Binding GameFolder.IsCandidateListVisible}">
                <ItemsControl Name="GameFolderCandidates" ItemsSource="{Binding GameFolder.Candidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameFolderCandidateViewModel">
                            <Button Command="{Binding ChooseCommand}" Margin="0,0,0,6"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Folder}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SourceLabel}" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}"
                                               FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Name="ChooseGameFolderButton" Content="Wybierz folder gry…"
                    Command="{Binding GameFolder.ChooseFolderCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
        <TextBlock Name="GameFolderStatusText" Text="{Binding GameFolder.StatusText}"
                   IsVisible="{Binding GameFolder.IsStatusVisible}" TextWrapping="Wrap" />

        <!-- Always on screen, so the player reads both before Play (spec 0011 LEGAL-12, ADR-0069 §3). -->
        <StackPanel Spacing="6" Opacity="0.7">
            <TextBlock Name="RiskNoticeText" Text="{Binding RiskNotice}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Name="LauncherNoticeText" Text="{Binding LauncherNotice}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Disabled until #42 wires them, so a click never looks like it did something. -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <Button Grid.Column="0" Name="PatchButton" Content="Patch" IsEnabled="False"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" Name="PlayButton" Content="Play" IsEnabled="False"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ProgressBar Grid.Column="0" Name="PatchProgressBar" Minimum="0" Maximum="100"
                         Value="{Binding Progress.Percent}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Name="ProgressText" MinWidth="36" TextAlignment="Right"
                       Text="{Binding Progress.Percent, StringFormat='{}{0}%'}" VerticalAlignment="Center" />
        </Grid>

        <Button Name="SettingsButton" Content="Ustawienia" Click="OnSettingsClick" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
