@page "/editor/{Id:guid}"
@attribute [Authorize]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc
@using LotroKoniecDev.Frontend.Components.Pages.Translations
@using LotroKoniecDev.Frontend.Infrastructure.Forms
@using LotroKoniecDev.Frontend.Infrastructure.Hateoas
@using LotroKoniecDev.Frontend.Infrastructure.HttpClients
@using LotroKoniecDev.Hateoas.Abstractions
@using LotroKoniecDev.TranslationSystem.Contracts.Hateoas
@using LotroKoniecDev.TranslationSystem.Contracts.Translations
@using LotroKoniecDev.TranslationSystem.Primitives.Aggregates.TranslationAggregate
@using LotroKoniecDev.TranslationSystem.Primitives.Constants
@inject TranslationEditorLoader Loader
@inject NavigationManager Navigation

<PageTitle>Edytor tłumaczenia — lotro-translator.pl</PageTitle>

<section class="container page-head">
    <div>
        <h1>Edytor tłumaczenia</h1>
        <p class="lede">
            Po lewej tekst angielski (do odczytu), po prawej Twoje tłumaczenie. Zachowaj znaczniki
            <code class="ph-token">@PlaceholderAnalyzer.Placeholder</code> w niezmienionej postaci.
        </p>
    </div>
    <div class="head-actions">
        <a class="btn btn-ghost" href="/translations">← Wróć do listy</a>
    </div>
</section>

<section class="container content-wrap">
    @if (_detail is null)
    {
        @if (_draftText is not null)
        {
            @* A save sent while the row could not be loaded still runs (#1122). When it fails, the typed
               text stays in a form that can be sent again. The hidden key fields survived the post. *@
            @if (_saveProblem is not null)
            {
                <div class="error-message" role="alert">
                    <span class="em-ico" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
                            <path d="M12 9v4"/><path d="M12 17h.01"/>
                        </svg>
                    </span>
                    <div class="em-body">
                        <ApiProblemAlert Problem="@_saveProblem"
                                         Fallback="Nie udało się zapisać tłumaczenia."
                                         HeadlineClass="t"/>
                    </div>
                </div>
            }
            <section class="panel">
                <header class="panel-head">
                    <h2>Tłumaczenie polskie</h2>
                    <span class="panel-aside">Wersja robocza</span>
                </header>
                <div class="panel-body">
                    <form method="post" @formname="@SaveFormName" @onsubmit="SaveAsync">
                        <AntiforgeryToken/>
                        <input type="hidden" name="FileIdField" value="@FileIdField"/>
                        <input type="hidden" name="GossipIdField" value="@GossipIdField"/>
                        <label class="visually-hidden" for="translated-recovery">Tłumaczenie polskie</label>
                        <textarea id="translated-recovery" name="DraftField" class="editor-textarea mono" rows="8"
                                  maxlength="@DatFormatConstants.MaxTranslatedTextLength"
                                  placeholder="Wpisz tłumaczenie…">@_draftText</textarea>
                        <div class="editor-actions" style="margin-top: 12px;">
                            <button type="submit" class="btn btn-primary">Zapisz ponownie</button>
                        </div>
                    </form>
                </div>
            </section>
        }
        else if (_loadProblem is not null)
        {
            @* The action happened even when the reload after its redirect fails, so the confirmation still
               shows (#1122). A post keeps the flag only because the address still has it, so it shows none. *@
            @if (_postedFormName is null && Saved)
            {
                <div class="status-message status-success" role="status">
                    <p>Tłumaczenie zapisano.</p>
                </div>
            }
            @if (_postedFormName is null && Approved)
            {
                <div class="status-message status-success" role="status">
                    <p>Tłumaczenie zatwierdzono i dołączono do dystrybucji.</p>
                </div>
            }
            <div class="error-message" role="alert">
                <span class="em-ico" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
                        <path d="M12 9v4"/><path d="M12 17h.01"/>
                    </svg>
                </span>
                <div class="em-body">
                    <ApiProblemAlert Problem="@_loadProblem"
                                     Fallback="Nie udało się wczytać tłumaczenia."
                                     HeadlineClass="t"/>
                </div>
            </div>

            <PostedFormTarget IsPageForm="@(static formName => formName == ApproveFormName)"/>
        }
        else
        {
            <div class="loading-indicator">
                <span class="li-spin"></span> Wczytywanie tłumaczenia…
            </div>
        }
    }
    else
    {
        TranslationDetailResponse detail = _detail;
        PlaceholderComparison comparison = PlaceholderAnalyzer.Compare(detail.SourceText, _draftText ?? detail.TranslatedText);

        <div class="results-meta">
            <span class="count">FileId <strong class="mono">@detail.FileId</strong></span>
            <span class="count">GossipId <strong class="mono">@detail.GossipId</strong></span>
            <span class="badge @TranslationStatusDisplay.BadgeClass(detail.Status)">
                <span class="dot"></span>@TranslationStatusDisplay.Label(detail.Status)
            </span>
        </div>

        @* A success flag stays in the URL after its redirect. It is hidden when the other action just
           failed, so a new error never sits next to an old confirmation. *@
        @if (_saveProblem is not null)
        {
            <div class="status-message status-error" role="alert">
                <ApiProblemAlert Problem="@_saveProblem" Fallback="Nie udało się zapisać tłumaczenia."/>
            </div>
        }
        else if (Saved && _approveProblem is null)
        {
            <div class="status-message status-success" role="status">
                <p>Tłumaczenie zapisano.</p>
            </div>
        }

        @if (_approveProblem is not null)
        {
            <div class="status-message status-error" role="alert">
                <ApiProblemAlert Problem="@_approveProblem" Fallback="Nie udało się zatwierdzić tłumaczenia."/>
            </div>
        }
        else if (Approved && _saveProblem is null)
        {
            <div class="status-message status-success" role="status">
                <p>Tłumaczenie zatwierdzono i dołączono do dystrybucji.</p>
            </div>
        }

        @if (!comparison.IsMatch)
        {
            <div class="status-message status-warning" role="alert">
                <p>
                    Liczba znaczników się nie zgadza: w tekście angielskim @comparison.SourceCount,
                    w tłumaczeniu @comparison.TranslatedCount. Zachowaj każdy znacznik
                    <code class="ph-token">@PlaceholderAnalyzer.Placeholder</code>.
                </p>
            </div>
        }

        <div class="editor-grid">
            <section class="panel">
                <header class="panel-head">
                    <h2>Tekst angielski</h2>
                    <span class="panel-aside">Oryginał</span>
                </header>
                <div class="panel-body">
                    <div class="editor-source">@RenderHighlighted(detail.SourceText)</div>

                    @if (!string.IsNullOrEmpty(detail.PreviousSourceText))
                    {
                        <div class="editor-superseded">
                            <h3 class="editor-pane-subtitle">Poprzednia wersja angielska (do porównania)</h3>
                            <div class="editor-source is-superseded">@RenderHighlighted(detail.PreviousSourceText)</div>
                        </div>
                    }
                </div>
            </section>

            <section class="panel">
                <header class="panel-head">
                    <h2>Tłumaczenie polskie</h2>
                    <span class="panel-aside">Edycja</span>
                </header>
                <div class="panel-body">
                    @{
                        LinkDto? upsertLink = detail.Links.FindLink(Rels.Upsert);
                    }
                    @if (upsertLink is not null)
                    {
                        <form method="post" @formname="@SaveFormName" @onsubmit="SaveAsync">
                            <AntiforgeryToken/>
                            <input type="hidden" name="FileIdField" value="@detail.FileId"/>
                            <input type="hidden" name="GossipIdField" value="@detail.GossipId"/>
                            <label class="visually-hidden" for="translated">Tłumaczenie polskie</label>
                            <textarea id="translated" name="DraftField" class="editor-textarea mono" rows="8"
                                      maxlength="@DatFormatConstants.MaxTranslatedTextLength"
                                      placeholder="Wpisz tłumaczenie…">@(_draftText ?? detail.TranslatedText)</textarea>
                            <div class="editor-actions" style="margin-top: 12px;">
                                <button type="submit" class="btn btn-primary">Zapisz</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <p class="text-dim">Ten wiersz jest tylko do odczytu.</p>
                    }

                    @if (detail.Links.HasLink(Rels.Approve))
                    {
                        <form method="post" @formname="@ApproveFormName" @onsubmit="ApproveAsync" class="editor-approve">
                            <AntiforgeryToken/>
                            <button type="submit" class="btn btn-ghost">Zatwierdź</button>
                        </form>
                    }
                </div>
            </section>
        </div>

        @if (_sameSourceTextFailed)
        {
            <div class="status-message status-warning same-source-unavailable" role="status">
                <p>Nie udało się wczytać innych wierszy z tym samym tekstem angielskim. Odśwież stronę, aby spróbować ponownie.</p>
            </div>
        }
        else if (_sameSourceText is { TotalCount: > 0 } sameSourceText)
        {
            <section class="panel same-source" aria-labelledby="same-source-title">
                <header class="panel-head">
                    <h2 id="same-source-title">Inne wiersze z tym samym tekstem</h2>
                    <span class="panel-aside">@sameSourceText.TotalCount</span>
                </header>
                <div class="panel-body">
                    @if (sameSourceText.HasConflictingTranslations)
                    {
                        <div class="status-message status-warning same-source-conflict" role="alert">
                            <p>Ten sam tekst angielski ma w różnych wierszach różne tłumaczenia polskie. Sprawdź, czy tak ma być.</p>
                        </div>
                    }
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th scope="col" class="col-num">FileId</th>
                                    <th scope="col" class="col-num">GossipId</th>
                                    <th scope="col">Tłumaczenie polskie</th>
                                    <th scope="col" class="col-status">Status</th>
                                    <th scope="col">Zapisane przez</th>
                                    <th scope="col" class="col-actions"><span class="visually-hidden">Akcje</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (SameSourceTextItemResponse other in sameSourceText.Items)
                                {
                                    <tr>
                                        <td class="col-num mono">@other.FileId</td>
                                        <td class="col-num mono">@other.GossipId</td>
                                        <td class="col-text">
                                            @if (string.IsNullOrEmpty(other.TranslatedText))
                                            {
                                                <span class="text-dim">—</span>
                                            }
                                            else
                                            {
                                                @other.TranslatedText
                                            }
                                        </td>
                                        <td class="col-status">
                                            <span class="badge @TranslationStatusDisplay.BadgeClass(other.Status)">
                                                <span class="dot"></span>@TranslationStatusDisplay.Label(other.Status)
                                            </span>
                                        </td>
                                        <td>@(other.Submitter?.DisplayName ?? "—")</td>
                                        <td class="col-actions">
                                            <a class="btn btn-ghost btn-sm" href="@OtherRowHref(other.Id)">Otwórz</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (sameSourceText.Items.Count < sameSourceText.TotalCount)
                    {
                        <p class="text-dim same-source-capped">
                            Pokazano @sameSourceText.Items.Count z @sameSourceText.TotalCount.
                            @if (sameSourceText.HasConflictingTranslations)
                            {
                                <a href="@ConflictListHref(detail.SourceText)">Pokaż rozbieżne tłumaczenia na liście</a>
                            }
                        </p>
                    }
                </div>
            </section>
        }
    }
</section>

@code
{
    private const string SaveFormName = "save-translation";
    private const string ApproveFormName = "approve-translation";

    /// <summary>
    /// The capped panel's list link searches for the English only up to this length, so the URL stays short.
    /// A longer text links to the whole conflict list.
    /// </summary>
    private const int MaxConflictSearchLength = 200;

    private TranslationDetailResponse? _detail;
    private SameSourceTextTranslationsResponse? _sameSourceText;
    private bool _sameSourceTextFailed;
    private ProblemDetails? _loadProblem;
    private ProblemDetails? _saveProblem;
    private ProblemDetails? _approveProblem;
    private string? _draftText;
    private string? _postedFormName;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = SaveFormName)]
    private string? DraftField { get; set; }

    [SupplyParameterFromForm(FormName = SaveFormName)]
    private int FileIdField { get; set; }

    [SupplyParameterFromForm(FormName = SaveFormName)]
    private long GossipIdField { get; set; }

    /// <summary>
    /// Set by the redirect, so the confirmation needs no per-user state on the server (#321). A manual
    /// reload shows it again, which is harmless.
    /// </summary>
    [SupplyParameterFromQuery]
    private bool Saved { get; set; }

    [SupplyParameterFromQuery]
    private bool Approved { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _postedFormName = PostedForm.NameOf(HttpContext);

        ApiResult<TranslationDetailResponse> result = await Loader.LoadAsync(TranslationId.FromValue(Id), CancellationToken.None);
        if (result.IsSuccess)
        {
            _detail = result.Value;
            _loadProblem = null;
            await LoadSameSourceTextAsync(result.Value);
        }
        else
        {
            _detail = null;
            _loadProblem = result.ProblemDetails;
            _sameSourceText = null;
            _sameSourceTextFailed = false;

            // A save sent while the row cannot be loaded keeps its text, which draws the recovery form.
            if (_postedFormName == SaveFormName)
            {
                _draftText ??= DraftField ?? string.Empty;
            }
        }
    }

    private async Task SaveAsync()
    {
        _saveProblem = null;
        _draftText = DraftField ?? string.Empty;

        // Never an href that came with the post: a changed post could send the request, and its token, to
        // another host. The upsert rel always points at the collection PUT, so when the row cannot give it,
        // the service document does (#610). The server still decides on the request.
        string? upsertHref = _detail?.Links.FindLink(Rels.Upsert)?.Href;
        if (upsertHref is null)
        {
            ApiResult<string> resolved = await Loader.ResolveCollectionUpsertHrefAsync(CancellationToken.None);
            if (resolved.IsFailure)
            {
                _saveProblem = resolved.ProblemDetails;
                return;
            }

            upsertHref = resolved.Value;
        }

        UpsertTranslationRequest request = new(FileIdField, GossipIdField, _draftText);
        ApiResult<TranslationDetailResponse> result = await Loader.SaveAsync(upsertHref, request, CancellationToken.None);

        if (result.IsSuccess)
        {
            // A failure does not redirect, so the typed draft and the error stay on screen.
            Navigation.NavigateTo(EditorUriWithFlag("saved"));
            return;
        }

        _saveProblem = result.ProblemDetails;
    }

    private async Task ApproveAsync()
    {
        _approveProblem = null;

        // The API sends the approve rel only to an admin on a Draft or NeedsReview row, so its presence is
        // the whole check.
        LinkDto? approveLink = _detail?.Links.FindLink(Rels.Approve);
        if (approveLink is null)
        {
            return;
        }

        ApiResult result = await Loader.ApproveAsync(approveLink.Href, CancellationToken.None);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(EditorUriWithFlag("approved"));
            return;
        }

        _approveProblem = result.ProblemDetails;
    }

    /// <summary>
    /// Redirect after post (#321): a reload is a plain GET, and the fresh load shows the server's new
    /// links, such as the approve button after a save.
    /// </summary>
    private string EditorUriWithFlag(string successFlag) =>
        string.Create(CultureInfo.InvariantCulture, $"/editor/{Id}?{successFlag}=true");

    /// <summary>
    /// Its own state, so a failed panel never hides the row (#1347). Skipped on a post: a good save or
    /// approve redirects to a GET that loads it, so a post would pay for the lookup twice.
    /// </summary>
    private async Task LoadSameSourceTextAsync(TranslationDetailResponse detail)
    {
        _sameSourceText = null;
        _sameSourceTextFailed = false;

        string? sameSourceTextHref = detail.Links.FindLink(Rels.SameSourceText)?.Href;
        if (sameSourceTextHref is null || HttpContext is not null && HttpMethods.IsPost(HttpContext.Request.Method))
        {
            return;
        }

        ApiResult<SameSourceTextTranslationsResponse> result =
            await Loader.LoadSameSourceTextAsync(sameSourceTextHref, CancellationToken.None);
        if (result.IsSuccess)
        {
            _sameSourceText = result.Value;
        }
        else
        {
            _sameSourceTextFailed = true;
        }
    }

    private static string OtherRowHref(TranslationId id) =>
        string.Create(CultureInfo.InvariantCulture, $"/editor/{id.Value}");

    /// <summary>
    /// The list's conflict filter is the uncapped view of these rows. The English goes in as the search term
    /// while it is short. The list's search is a substring match over English and Polish, and only very
    /// common texts fill the panel, so the list can show many conflict rows of other texts too; for an
    /// empty text it shows the whole conflict list.
    /// </summary>
    private static string ConflictListHref(string sourceText) =>
        TranslationListQuery
            .From(
                sourceText.Length <= MaxConflictSearchLength ? sourceText : null,
                status: null,
                page: 1,
                conflictsOnly: true)
            .ToPageRelativeUri(1);

    private static RenderFragment RenderHighlighted(string text) => builder =>
    {
        int sequence = 0;
        foreach (PlaceholderSegment segment in PlaceholderAnalyzer.Segment(text))
        {
            if (segment.IsPlaceholder)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "ph-token");
                builder.AddContent(sequence++, segment.Text);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(sequence++, segment.Text);
            }
        }
    };
}
