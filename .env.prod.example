# Template for the git-ignored .env.prod consumed by compose.prod.yaml (the production-PARITY stack).
# Staging mirrors these keys with *.staging.lotro-translator.pl hostnames + lotrotms-kv-staging vault (see runbook §"Staging bring-up").
# Copy it, fill the secrets, then boot:
#   cp .env.prod.example .env.prod
#   scripts/gen-openiddict-keys.sh >> .env.prod      # fills the three OpenIddict secrets below
#   scripts/init-prod-https.sh                       # local CA + proxy/postgres certs
#   docker compose -f compose.prod.yaml --env-file .env.prod up --build
#
# URLs and in-stack topology (issuer, redirect URIs, CORS origin, the Auth issuer/authority split)
# are NOT here — they are literal in compose.prod.yaml because they ARE this stack's wiring. This
# file holds only secrets and the Postgres connection (the managed-DB swap point). A real cloud
# deployment injects all of these via its own orchestrator under ASPNETCORE_ENVIRONMENT=Production.

# --- Postgres (self-hosted in the stack; SSL on) ---
# Password for the bundled Postgres. It also appears inside the two connection strings below — keep
# them in sync. Pick your own; .env.prod is git-ignored.
POSTGRES_PASSWORD=changeme-prod-password

# --- Database connection strings (THE managed-DB swap point) ---
# Default: the in-stack Postgres over SSL (self-signed server cert -> Trust Server Certificate=true).
# To use a managed instance (Azure Database for PostgreSQL / AWS RDS / Aiven), replace JUST these two
# values with the managed connection string (typically Ssl Mode=Require, no Trust Server Certificate).
# Nothing else in the stack changes.
ConnectionStrings__TranslationDatabase=Host=postgres;Port=5432;Database=lotro_translation;Username=postgres;Password=changeme-prod-password;Ssl Mode=Require;Trust Server Certificate=true
ConnectionStrings__AuthDatabase=Host=postgres;Port=5432;Database=lotro_auth;Username=postgres;Password=changeme-prod-password;Ssl Mode=Require;Trust Server Certificate=true

# --- OpenIddict production keys (auth-api; fail-fast at startup if missing/invalid) ---
# Generate all three at once with: scripts/gen-openiddict-keys.sh >> .env.prod
#   OpenIddict__EncryptionKey__Key            base64 of a >= 32-byte symmetric key
#   OpenIddict__SigningKey__RsaPrivateKeyXml  base64 of RSA.ToXmlString(true), >= 2048-bit
#   OpenIddict__ApiClientSecret               >= 32 characters (service-to-service client secret)
OpenIddict__EncryptionKey__Key=
OpenIddict__SigningKey__RsaPrivateKeyXml=
OpenIddict__ApiClientSecret=

# --- SMTP (auth-api sends email confirmation / password reset; /health/ready probes it) ---
# Real deployment: point at your provider (e.g. smtp.sendgrid.net / smtp.eu.mailgun.org).
# All-local parity run: enable `--profile local-smtp` and set Host=mailpit, Port=1025, Mode=None.
# Mode is one of: None | StartTls | TLS.
Email__Host=mailpit
Email__Port=1025
Email__Mode=None
Email__SenderEmail=no-reply@lotro-translator.pl
Email__Sender=LOTRO PL
# Optional SMTP auth — leave blank for an unauthenticated relay (e.g. mailpit). If Username is set,
# Password is required.
Email__Username=
Email__Password=

# --- Auth admin seed (optional; seeded into the auth DB on first boot) ---
# Leave blank to skip admin seeding. Set all three to seed a usable login.
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=

# --- Telemetry (optional) ---
# Leave empty to disable OTLP export. For an all-local run, enable `--profile local-otel` and set
# this to http://aspire-dashboard:18889 to view traces/metrics/logs at http://localhost:18888.
OTEL_EXPORTER_OTLP_ENDPOINT=
