@page "/translations"
@attribute [Authorize(Policy = ReadOnlyForVisitorsPolicy.Name)]
@attribute [StreamRendering]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc
@using LotroKoniecDev.Frontend.Components.Pages.Editor
@using LotroKoniecDev.Frontend.Infrastructure.Auth
@using LotroKoniecDev.Frontend.Infrastructure.Forms
@using LotroKoniecDev.Frontend.Infrastructure.Hateoas
@using LotroKoniecDev.Frontend.Infrastructure.HttpClients
@using LotroKoniecDev.Hateoas.Abstractions
@using LotroKoniecDev.TranslationSystem.Contracts.Common
@using LotroKoniecDev.TranslationSystem.Contracts.Hateoas
@using LotroKoniecDev.TranslationSystem.Contracts.Translations
@using LotroKoniecDev.TranslationSystem.Primitives.Aggregates.TranslationAggregate
@using LotroKoniecDev.TranslationSystem.Primitives.Aggregates.TranslationAggregate.Enums
@using LotroKoniecDev.TranslationSystem.Primitives.Constants
@inject TranslationListLoader Loader
@inject NavigationManager Navigation

<PageTitle>Tłumaczenia — lotro-translator.pl</PageTitle>

<section class="container page-head">
    <div>
        <h1>Tłumaczenia</h1>
        <p class="lede">Przeglądaj, wyszukuj i filtruj teksty zaimportowane z gry.</p>
    </div>
</section>

<section class="filter-wrap">
    <div class="container">
        <form class="filter" method="get">
            <div class="field">
                <label for="search">Wyszukaj</label>
                <input id="search" name="search" type="search" value="@_query.Search"
                       placeholder="Tekst, FileId lub GossipId…" autocomplete="off"/>
            </div>
            <div class="field field-match">
                <label for="match">Dopasowanie</label>
                <div class="select-wrap">
                    <select id="match" name="match" title="Cały tekst pomija spacje na brzegach i znacznik na końcu, np. [e]">
                        <option value="" selected="@(_query.Match is TranslationSearchMatch.Contains)">Zawiera</option>
                        <option value="@TranslationSearchMatch.WholeWord" selected="@(_query.Match is TranslationSearchMatch.WholeWord)">Całe słowo</option>
                        <option value="@TranslationSearchMatch.WholeText" selected="@(_query.Match is TranslationSearchMatch.WholeText)">Cały tekst</option>
                    </select>
                    <span class="select-chev" aria-hidden="true">▾</span>
                </div>
            </div>
            <div class="field field-status">
                <label for="status">Status</label>
                <div class="select-wrap">
                    <select id="status" name="status">
                        <option value="">Wszystkie</option>
                        @foreach (TranslationStatus status in TranslationStatusDisplay.FilterableStatuses)
                        {
                            <option value="@status" selected="@(_query.Status == status)">
                                @TranslationStatusDisplay.Label(status)
                            </option>
                        }
                    </select>
                    <span class="select-chev" aria-hidden="true">▾</span>
                </div>
            </div>
            <div class="field field-page-size">
                <label for="pageSize">Na stronie</label>
                <div class="select-wrap">
                    <select id="pageSize" name="pageSize">
                        @foreach (int size in TranslationListQuery.PageSizeOptions)
                        {
                            <option value="@size" selected="@(_query.PageSize == size)">@size</option>
                        }
                    </select>
                    <span class="select-chev" aria-hidden="true">▾</span>
                </div>
            </div>
            <div class="field-static field-conflicts">
                @* value="true", because the browser sends "on" for a bare checkbox, and only "true" turns the filter on. *@
                <label class="checkbox" title="Ten sam tekst angielski ma w różnych wierszach różne tłumaczenia polskie">
                    <input id="conflictsOnly" name="conflictsOnly" type="checkbox" value="true" checked="@_query.ConflictsOnly"/>
                    <span class="box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5"/>
                        </svg>
                    </span>
                    <span>Tylko rozbieżne tłumaczenia</span>
                </label>
            </div>
            <AuthorizeView>
                <Authorized>
                    @* Only for a signed-in user: "mine" means the rows whose current Polish text this user saved (#1491). *@
                    <div class="field-static field-mine">
                        <label class="checkbox" title="Wiersze, w których obecny tekst polski jest Twój; najnowsza zmiana na górze">
                            <input id="mine" name="mine" type="checkbox" value="true" checked="@_query.Mine"/>
                            <span class="box">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20 6 9 17l-5-5"/>
                                </svg>
                            </span>
                            <span>Tylko moje</span>
                        </label>
                    </div>
                </Authorized>
            </AuthorizeView>
            <div class="filter-actions">
                <a class="btn btn-ghost" href="/translations">Wyczyść</a>
                <button type="submit" class="btn btn-primary">Filtruj</button>
            </div>
        </form>
    </div>
</section>

<section class="container content-wrap">
    @* Blazor sends a post only to a form on the page (#1122), and the save runs before the list loads. So
       the posted form is drawn here when its row does not draw it: hidden during the save, and with the
       typed text after a refusal when the row left the list. *@
    @if (_inlineSaveId is { } postedRowId && !DrawsRowForm(postedRowId))
    {
        @if (!_inlineRefused)
        {
            <form method="post" @formname="@InlineSaveFormName(postedRowId)" @onsubmit="SaveInlineAsync" hidden></form>
        }
        else if (!IsRowOnPage(postedRowId))
        {
            <div class="inline-recovery" id="@TranslationListQuery.RowElementId(postedRowId)">
                @InlineRecoveryForm(postedRowId)
            </div>
        }
    }

    @if (_result is null)
    {
        <div class="loading-indicator">
            <span class="li-spin"></span> Wczytywanie tłumaczeń…
        </div>
    }
    else if (_result.IsFailure)
    {
        @* The save happened even when the list cannot load after its redirect (#1122). *@
        @if (_savedRow is not null)
        {
            <div class="status-message status-success" role="status">
                <p>Tłumaczenie zapisano.</p>
            </div>
        }
        @LastRowNote()
        <div class="error-message" role="alert">
            <span class="em-ico" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
                    <path d="M12 9v4"/><path d="M12 17h.01"/>
                </svg>
            </span>
            <div class="em-body">
                <ApiProblemAlert Problem="@_result.ProblemDetails"
                                 Fallback="Nie udało się wczytać tłumaczeń."
                                 HeadlineClass="t"/>
            </div>
        </div>

        <PostedFormTarget IsPageForm="@(static formName => formName == BulkApproveFormName)"/>
    }
    else
    {
        PaginationResponse<TranslationListItemResponse> pageData = _result.Value;

        // The server decides: the admin-only `bulk-approve` rel shows the checkbox column, and each row's
        // `approve` rel decides whether that row can be ticked. Never a role check here (ADR-0040).
        bool canBulkApprove = pageData.Links.HasLink(Rels.BulkApprove);
        bool anyApprovable = canBulkApprove && pageData.Items.Any(item => item.Links.HasLink(Rels.Approve));

        <div class="results-meta">
            <span class="count">Znaleziono: <strong>@pageData.TotalCount</strong></span>
            @if (pageData.TotalPages > 0)
            {
                <span class="count">Strona @pageData.Page z @pageData.TotalPages</span>
            }
        </div>

        @if (_bulkProblem is not null)
        {
            <div class="status-message status-error" role="alert">
                <ApiProblemAlert Problem="@_bulkProblem" Fallback="Nie udało się zatwierdzić tłumaczeń."/>
            </div>
        }
        else if (_bulkNotice is not null)
        {
            <div class="status-message status-warning" role="status">
                <p>@_bulkNotice</p>
            </div>
        }
        else if (Approved is { } approvedCount)
        {
            @if (approvedCount > 0)
            {
                <div class="status-message status-success" role="status">
                    <p>
                        Zatwierdzono @approvedCount @TranslationsPlural(approvedCount).@((Skipped ?? 0) > 0 ? $" Pominięto {Skipped}." : "")
                    </p>
                </div>
            }
            else
            {
                <div class="status-message status-warning" role="status">
                    <p>Nie zatwierdzono żadnego tłumaczenia — wybrane wiersze mogły być już zatwierdzone lub nieaktualne.</p>
                </div>
            }
        }

        @LastRowNote()

        @if (pageData.Items.Count == 0)
        {
            @if (_savedRow is { } savedRowOffEmptyPage)
            {
                <div class="row-note-alone" id="@TranslationListQuery.RowElementId(savedRowOffEmptyPage)">
                    @SavedRowLeftNote(savedRowOffEmptyPage)
                </div>
            }
            <div class="empty">
                <span class="empty-glyph" aria-hidden="true">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.3-4.3"/>
                    </svg>
                </span>
                <h2>Brak wyników</h2>
                <p>Żadne tłumaczenie nie pasuje do wybranych kryteriów.</p>
            </div>
        }
        else
        {
            int columnCount = canBulkApprove ? 7 : 6;
            TranslationId? rowAbove = null;

            @* The table sits outside this form: each row holds its own save form, and HTML drops a form
               inside another form. The checkboxes join it by its id. It posts to a clean list address, so
               no old note comes back with it. *@
            @if (canBulkApprove)
            {
                <form id="@BulkApproveFormName" method="post" @formname="@BulkApproveFormName" @onsubmit="ApproveSelectedAsync"
                      action="@_query.ToPageRelativeUri(_query.Page)">
                    <AntiforgeryToken/>
                    @if (anyApprovable)
                    {
                        <div class="bulk-bar">
                            <button type="submit" class="btn btn-primary btn-sm">Zatwierdź zaznaczone</button>
                        </div>
                    }
                </form>
            }

            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            @if (canBulkApprove)
                            {
                                <th scope="col" class="col-check"><span class="visually-hidden">Zaznacz</span></th>
                            }
                            <th scope="col" class="col-num">FileId</th>
                            <th scope="col" class="col-num">GossipId</th>
                            <th scope="col">Tekst angielski</th>
                            <th scope="col">Tłumaczenie polskie</th>
                            <th scope="col" class="col-status">Status</th>
                            <th scope="col" class="col-actions"><span class="visually-hidden">Akcje</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_savedRow is { } savedRowOffTop && !IsRowOnPage(savedRowOffTop) && !IsRowOnPage(_savedAfter))
                        {
                            <tr class="row-note" id="@TranslationListQuery.RowElementId(savedRowOffTop)">
                                <td colspan="@columnCount">@SavedRowLeftNote(savedRowOffTop)</td>
                            </tr>
                        }
                        @foreach (TranslationListItemResponse item in pageData.Items)
                        {
                            bool refused = _inlineRefused && _inlineSaveId == item.Id;
                            bool refusedWithoutItsForm = refused && !DrawsInlineForm(item);
                            <tr id="@TranslationListQuery.RowElementId(item.Id)">
                                @if (canBulkApprove)
                                {
                                    <td class="col-check">
                                        @* The same `approve` rel the editor's Zatwierdź button uses. A field #1384 adds
                                           per row for the bulk approve needs this form attribute too. *@
                                        @if (item.Links.HasLink(Rels.Approve))
                                        {
                                            <input type="checkbox" name="SelectedRows[@item.Id.Value]" value="true"
                                                   form="@BulkApproveFormName" aria-label="Zaznacz do zatwierdzenia"/>
                                        }
                                    </td>
                                }
                                <td class="col-num mono">@item.FileId</td>
                                <td class="col-num mono">@item.GossipId</td>
                                <td class="col-text">@item.SourceText</td>
                                <td class="col-text">
                                    @if (string.IsNullOrWhiteSpace(item.TranslatedText))
                                    {
                                        <span class="text-dim">—</span>
                                    }
                                    else
                                    {
                                        @item.TranslatedText
                                    }
                                    @if (DrawsInlineForm(item))
                                    {
                                        string textId = InlineTextElementId(item.Id);
                                        <details class="inline-edit" open="@refused">
                                            <summary>Edytuj tutaj</summary>
                                            @* Never data-enhance: an enhanced post loses the #row fragment of its redirect. *@
                                            <form method="post" class="inline-edit-form" @formname="@InlineSaveFormName(item.Id)"
                                                  @onsubmit="SaveInlineAsync" action="@_query.ToInlineSaveActionUri(item.Id)">
                                                <AntiforgeryToken/>
                                                <input type="hidden" name="InlineFileId" value="@item.FileId"/>
                                                <input type="hidden" name="InlineGossipId" value="@item.GossipId"/>
                                                @if (rowAbove is { } above)
                                                {
                                                    <input type="hidden" name="InlineSavedAfter" value="@above.Value"/>
                                                }
                                                <label class="visually-hidden" for="@textId">Tłumaczenie polskie, FileId @item.FileId, GossipId @item.GossipId</label>
                                                <textarea id="@textId" name="InlineText" class="editor-textarea mono" rows="3"
                                                          maxlength="@DatFormatConstants.MaxTranslatedTextLength"
                                                          placeholder="Wpisz tłumaczenie…">@(refused ? _inlineText : item.TranslatedText)</textarea>
                                                @if (refused)
                                                {
                                                    <div class="status-message status-error" role="alert">
                                                        <ApiProblemAlert Problem="@_inlineProblem" Fallback="@SaveFailedMessage"/>
                                                    </div>
                                                    @SlipWarnings(TranslationSlipChecker.Check(item.SourceText, _inlineText))
                                                }
                                                <div>
                                                    <button type="submit" class="btn btn-primary btn-sm">Zapisz</button>
                                                </div>
                                            </form>
                                        </details>
                                    }
                                </td>
                                <td class="col-status">
                                    <span class="badge @TranslationStatusDisplay.BadgeClass(item.Status)">
                                        <span class="dot"></span>@TranslationStatusDisplay.Label(item.Status)
                                    </span>
                                </td>
                                <td class="col-actions">
                                    @if (item.Links.HasLink(Rels.Upsert))
                                    {
                                        <a class="btn btn-ghost btn-sm" href="@EditorHref(item)">Edytuj</a>
                                    }
                                </td>
                            </tr>
                            @if (refusedWithoutItsForm)
                            {
                                <tr class="row-note">
                                    <td colspan="@columnCount">
                                        <div class="inline-recovery">@InlineRecoveryForm(item.Id)</div>
                                        @SlipWarnings(TranslationSlipChecker.Check(item.SourceText, _inlineText))
                                    </td>
                                </tr>
                            }
                            else if (_savedRow == item.Id)
                            {
                                <tr class="row-note">
                                    <td colspan="@columnCount">
                                        <div class="status-message status-success" role="status">
                                            <p>Tłumaczenie zapisano.</p>
                                        </div>
                                        @SlipWarnings(TranslationSlipChecker.Check(item.SourceText, item.TranslatedText))
                                    </td>
                                </tr>
                            }
                            else if (_savedRow is { } savedRowOff && _savedAfter == item.Id && !IsRowOnPage(savedRowOff))
                            {
                                <tr class="row-note" id="@TranslationListQuery.RowElementId(savedRowOff)">
                                    <td colspan="@columnCount">@SavedRowLeftNote(savedRowOff)</td>
                                </tr>
                            }
                            rowAbove = item.Id;
                        }
                    </tbody>
                </table>
            </div>
        }

        @* The pager buttons come from the server's pagination links, never from Page and TotalPages
           (#158). The pager sits outside the empty-state branch: a page past the end has no rows but
           still carries first-page and last-page, so the user has a way back (#634). All four rels are
           checked, because nothing guarantees which of them come together. *@
        @if (pageData.Links.HasLink(Rels.FirstPage)
             || pageData.Links.HasLink(Rels.PreviousPage)
             || pageData.Links.HasLink(Rels.NextPage)
             || pageData.Links.HasLink(Rels.LastPage))
        {
            <nav class="pager" aria-label="Stronicowanie">
                @if (pageData.Links.HasLink(Rels.FirstPage))
                {
                    <a class="btn btn-ghost" href="@_query.ToPageRelativeUri(1)" rel="first">« Pierwsza</a>
                }
                else
                {
                    <span class="btn btn-ghost is-disabled" aria-disabled="true">« Pierwsza</span>
                }

                @if (pageData.Links.HasLink(Rels.PreviousPage))
                {
                    <a class="btn btn-ghost" href="@_query.ToPageRelativeUri(pageData.Page - 1)" rel="prev">← Poprzednia</a>
                }
                else
                {
                    <span class="btn btn-ghost is-disabled" aria-disabled="true">← Poprzednia</span>
                }

                <span class="pager-status">@pageData.Page / @pageData.TotalPages</span>

                @if (pageData.Links.HasLink(Rels.NextPage))
                {
                    <a class="btn btn-ghost" href="@_query.ToPageRelativeUri(pageData.Page + 1)" rel="next">Następna →</a>
                }
                else
                {
                    <span class="btn btn-ghost is-disabled" aria-disabled="true">Następna →</span>
                }

                @if (pageData.Links.HasLink(Rels.LastPage))
                {
                    <a class="btn btn-ghost" href="@_query.ToPageRelativeUri(pageData.TotalPages)" rel="last">Ostatnia »</a>
                }
                else
                {
                    <span class="btn btn-ghost is-disabled" aria-disabled="true">Ostatnia »</span>
                }
            </nav>
        }
    }
</section>

@code
{
    private const string BulkApproveFormName = "bulk-approve";
    private const string InlineSaveFormNamePrefix = "inline-save-";
    private const string SaveFailedMessage = "Nie udało się zapisać tłumaczenia.";

    private TranslationListQuery _query = TranslationListQuery.From(null, null, 1);
    private ApiResult<PaginationResponse<TranslationListItemResponse>>? _result;
    private ProblemDetails? _bulkProblem;
    private string? _bulkNotice;

    /// <summary>The row whose inline form was posted (#1493), read from the posted form's name.</summary>
    private TranslationId? _inlineSaveId;

    private bool _inlineRefused;
    private ProblemDetails? _inlineProblem;
    private string? _inlineText;

    /// <summary>The note after a good inline save, read only on a GET.</summary>
    private TranslationId? _savedRow;

    private TranslationId? _savedAfter;
    private bool _savedSlips;

    /// <summary>
    /// The note after "Zapisz i następny" or "Następny" passed the last row (#1490, #1585), read only on a GET.
    /// </summary>
    private string? _lastRowNote;

    [SupplyParameterFromQuery]
    private string? Search { get; set; }

    [SupplyParameterFromQuery]
    private string? Status { get; set; }

    [SupplyParameterFromQuery]
    private int Page { get; set; }

    [SupplyParameterFromQuery]
    private int? PageSize { get; set; }

    /// <summary>
    /// A string, so a link with a value that is not a bool (<c>on</c>, <c>1</c>) still shows the list. A typed
    /// bool parameter throws while it binds, and the page becomes the layout's error page.
    /// </summary>
    [SupplyParameterFromQuery]
    private string? ConflictsOnly { get; set; }

    /// <summary>
    /// A string for the same reason as <see cref="ConflictsOnly"/>: an unknown mode falls back to "Zawiera"
    /// instead of breaking the page.
    /// </summary>
    [SupplyParameterFromQuery]
    private string? Match { get; set; }

    /// <summary>
    /// A string for the same reason as <see cref="ConflictsOnly"/>. A visitor's value is dropped (#1491).
    /// </summary>
    [SupplyParameterFromQuery]
    private string? Mine { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>
    /// Set by the redirect after a bulk approve, so the confirmation needs no per-user state on the server
    /// (#322). Null on a plain GET. A manual reload shows the message again, which is harmless.
    /// </summary>
    [SupplyParameterFromQuery]
    private int? Approved { get; set; }

    [SupplyParameterFromQuery]
    private int? Skipped { get; set; }

    /// <summary>
    /// Strings for the same reason as <see cref="ConflictsOnly"/>: a value that is not a row id shows the list
    /// with no note.
    /// </summary>
    [SupplyParameterFromQuery(Name = TranslationListQuery.SavedRowName)]
    private string? SavedRow { get; set; }

    [SupplyParameterFromQuery(Name = TranslationListQuery.SavedAfterName)]
    private string? SavedAfter { get; set; }

    [SupplyParameterFromQuery(Name = TranslationListQuery.SavedSlipsName)]
    private string? SavedSlips { get; set; }

    [SupplyParameterFromQuery(Name = TranslationListQuery.LastRowName)]
    private string? LastRow { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// Static SSR form binding reads keyed names such as <c>SelectedRows[&lt;id&gt;]</c>; a repeated plain name
    /// does not bind to a collection. Only ticked rows are posted.
    /// </summary>
    [SupplyParameterFromForm(FormName = BulkApproveFormName)]
    private Dictionary<Guid, bool>? SelectedRows { get; set; }

    /// <summary>
    /// No form name on the inline fields: every row's form has its own name, and these come with any of them.
    /// </summary>
    [SupplyParameterFromForm]
    private int InlineFileId { get; set; }

    [SupplyParameterFromForm]
    private long InlineGossipId { get; set; }

    [SupplyParameterFromForm]
    private string? InlineText { get; set; }

    /// <summary>The row above the posted one, for the note when the save takes the row off the page.</summary>
    [SupplyParameterFromForm]
    private string? InlineSavedAfter { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _query = TranslationListQuery.From(
            Search,
            Status,
            Page,
            PageSize,
            TranslationListQuery.ParseConflictsOnly(ConflictsOnly),
            TranslationListQuery.ParseMatch(Match),
            TranslationListQuery.ParseMine(Mine) && await IsSignedInAsync());

        string? postedFormName = PostedForm.NameOf(HttpContext);
        _inlineSaveId = InlineSaveIdOf(postedFormName);

        // The list's own forms post to an address with no note, but a hand-made post may still carry one, so a
        // post shows none (#1122).
        if (postedFormName is null)
        {
            _savedRow = ParseRowId(SavedRow);
            _savedAfter = ParseRowId(SavedAfter);
            _savedSlips = bool.TryParse(SavedSlips, out bool hasSlips) && hasSlips;
            _lastRowNote = LastRow switch
            {
                TranslationListQuery.LastRowSavedValue => "Tłumaczenie zapisano. To był ostatni wiersz tej listy.",
                TranslationListQuery.LastRowUnchangedValue => "To był ostatni wiersz tej listy.",
                _ => null
            };
        }

        // The save does not need the list, so a good save costs no list read. A refused one loads it.
        if (_inlineSaveId is not null)
        {
            return;
        }

        _result = await Loader.LoadAsync(_query, CancellationToken.None);
    }

    private async Task ApproveSelectedAsync()
    {
        _bulkProblem = null;
        _bulkNotice = null;

        // The API sends the `bulk-approve` rel only to an admin, so its presence is the whole check.
        LinkDto? bulkLink = _result is { IsSuccess: true }
            ? _result.Value.Links.FindLink(Rels.BulkApprove)
            : null;
        if (bulkLink is null)
        {
            return;
        }

        Guid[] ids = SelectedRows is null
            ? []
            : [.. SelectedRows.Where(pair => pair.Value).Select(pair => pair.Key)];
        if (ids.Length == 0)
        {
            _bulkNotice = "Zaznacz co najmniej jeden wiersz do zatwierdzenia.";
            return;
        }

        ApiResult<BulkApproveTranslationsResponse> result =
            await Loader.BulkApproveAsync(bulkLink.Href, ids, CancellationToken.None);
        if (result.IsSuccess)
        {
            // Redirect after post (#321): a reload is a plain GET, and the fresh load drops the checkbox of
            // rows just approved. A failure does not redirect, so the problem stays on screen.
            Navigation.NavigateTo(
                _query.ToPageRelativeUriWithApprovalResult(result.Value.Approved, result.Value.Skipped));
            return;
        }

        _bulkProblem = result.ProblemDetails;
    }

    private async Task SaveInlineAsync()
    {
        string text = InlineText ?? string.Empty;
        ApiResult<TranslationDetailResponse> result = await Loader.SaveAsync(
            new UpsertTranslationRequest(InlineFileId, InlineGossipId, text),
            CancellationToken.None);

        if (result.IsSuccess)
        {
            // Redirect after post (#321). The page is streamed, so after a slow save blazor.web.js follows
            // the redirect, and the browser still scrolls to its #row fragment.
            TranslationDetailResponse saved = result.Value;
            bool hasSlips = TranslationSlipChecker.Check(saved.SourceText, saved.TranslatedText).Count > 0;
            Navigation.NavigateTo(
                _query.ToPageRelativeUriWithSavedRow(saved.Id, ParseRowId(InlineSavedAfter), hasSlips));
            return;
        }

        // A refusal does not redirect: the typed text and the error stay in the row, on the list as it is now.
        _result = await Loader.LoadAsync(_query, CancellationToken.None);
        _inlineText = text;
        _inlineProblem = result.ProblemDetails;
        _inlineRefused = true;
    }

    private async Task<bool> IsSignedInAsync()
    {
        if (AuthenticationState is null)
        {
            return false;
        }

        AuthenticationState state = await AuthenticationState;
        return state.User.Identity?.IsAuthenticated ?? false;
    }

    /// <summary>
    /// The editor gets the list state, so its way back shows this list again (#1452), and the row's place, so
    /// "Zapisz i następny" and "Następny" can go on in this list (#1490).
    /// </summary>
    private string EditorHref(TranslationListItemResponse item) =>
        _query.ToEditorRelativeUri(item.Id, item.Place);

    /// <summary>The server decides: only a row it lets the caller save carries <c>upsert</c> (ADR-0040).</summary>
    private static bool DrawsInlineForm(TranslationListItemResponse item) =>
        item.Links.HasLink(Rels.Upsert);

    private bool DrawsRowForm(TranslationId id) =>
        _result is { IsSuccess: true } && _result.Value.Items.Any(item => item.Id == id && DrawsInlineForm(item));

    private bool IsRowOnPage(TranslationId? id) =>
        id is { } rowId && _result is { IsSuccess: true } && _result.Value.Items.Any(item => item.Id == rowId);

    /// <summary>
    /// A form name per row: static SSR sends the post to the matching <c>@@formname</c>.
    /// </summary>
    private static string InlineSaveFormName(TranslationId id) =>
        string.Create(CultureInfo.InvariantCulture, $"{InlineSaveFormNamePrefix}{id.Value:D}");

    private static string InlineTextElementId(TranslationId id) =>
        string.Create(CultureInfo.InvariantCulture, $"inline-text-{id.Value:D}");

    /// <summary>Only a name this page draws counts. Any other name still gets Blazor's 400.</summary>
    private static TranslationId? InlineSaveIdOf(string? postedFormName) =>
        postedFormName is not null
        && postedFormName.StartsWith(InlineSaveFormNamePrefix, StringComparison.Ordinal)
        && Guid.TryParseExact(postedFormName.AsSpan(InlineSaveFormNamePrefix.Length), "D", out Guid id)
            ? TranslationId.FromValue(id)
            : null;

    private static TranslationId? ParseRowId(string? value) =>
        Guid.TryParse(value, out Guid id) ? TranslationId.FromValue(id) : null;

    /// <summary>
    /// The note in the saved row's place when the save took it off this page, for example out of a status
    /// filter. A message needs both texts, so for slips the note only points to the editor.
    /// </summary>
    private RenderFragment SavedRowLeftNote(TranslationId savedRow) =>
        @<text>
            <div class="status-message status-success" role="status">
                <p>Tłumaczenie zapisano. Tego wiersza nie ma już na tej stronie listy.</p>
            </div>
            @if (_savedSlips)
            {
                <div class="status-message status-warning" role="status">
                    <p>
                        Edytor pokazuje uwagi do tego tekstu.
                        <a href="@_query.ToEditorRelativeUri(savedRow)">Otwórz w edytorze</a>
                    </p>
                </div>
            }
        </text>;

    /// <summary>
    /// Shown in every branch, an empty page and a failed load included, so a save is never left without a sign.
    /// </summary>
    private RenderFragment LastRowNote() =>
        @<text>
            @if (_lastRowNote is not null)
            {
                <div class="status-message status-success last-row-note" role="status">
                    <p>@_lastRowNote</p>
                </div>
            }
        </text>;

    /// <summary>
    /// The refused text of a row whose own form is not drawn: the row left the list, the list did not load, or
    /// the row no longer offers its save. The key fields come from the post, as in the editor's recovery form.
    /// </summary>
    private RenderFragment InlineRecoveryForm(TranslationId postedRowId) =>
        @<text>
            <div class="status-message status-error" role="alert">
                <ApiProblemAlert Problem="@_inlineProblem" Fallback="@SaveFailedMessage"/>
            </div>
            <form method="post" class="inline-edit-form" @formname="@InlineSaveFormName(postedRowId)"
                  @onsubmit="SaveInlineAsync" action="@_query.ToInlineSaveActionUri(postedRowId)">
                <AntiforgeryToken/>
                <input type="hidden" name="InlineFileId" value="@InlineFileId"/>
                <input type="hidden" name="InlineGossipId" value="@InlineGossipId"/>
                @if (ParseRowId(InlineSavedAfter) is { } rowAbove)
                {
                    <input type="hidden" name="InlineSavedAfter" value="@rowAbove.Value"/>
                }
                <p>Tekstu nie zapisano. Jest poniżej, więc możesz go poprawić i zapisać ponownie.</p>
                <label for="inline-text-recovery">Tłumaczenie polskie, FileId @InlineFileId, GossipId @InlineGossipId</label>
                <textarea id="inline-text-recovery" name="InlineText" class="editor-textarea mono" rows="3"
                          maxlength="@DatFormatConstants.MaxTranslatedTextLength">@_inlineText</textarea>
                <div>
                    <button type="submit" class="btn btn-primary btn-sm">Zapisz ponownie</button>
                </div>
            </form>
        </text>;

    /// <summary>Only advice, as in the editor (#1489).</summary>
    private static RenderFragment SlipWarnings(IReadOnlyList<TranslationSlip> slips) =>
        @<text>
            @if (slips.Count > 0)
            {
                <div class="status-message status-warning translation-slips" role="alert">
                    @foreach (TranslationSlip slip in slips)
                    {
                        <p>@slip.Message</p>
                    }
                </div>
            }
        </text>;

    /// <summary>
    /// The auth API has its own copy of this rule (<c>AuthSystem.API.Common.PolishPlural</c>, #1032).
    /// </summary>
    private static string TranslationsPlural(int count)
    {
        if (count == 1)
        {
            return "tłumaczenie";
        }

        int lastTwo = count % 100;
        int last = count % 10;
        return last is >= 2 and <= 4 && lastTwo is not (>= 12 and <= 14)
            ? "tłumaczenia"
            : "tłumaczeń";
    }
}
