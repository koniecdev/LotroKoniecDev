@page "/game-versions"
@attribute [Authorize]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc
@using LotroKoniecDev.Frontend.Infrastructure.Forms
@using LotroKoniecDev.Frontend.Infrastructure.Hateoas
@using LotroKoniecDev.Frontend.Infrastructure.HttpClients
@using LotroKoniecDev.Hateoas.Abstractions
@using LotroKoniecDev.TranslationSystem.Contracts.Common
@using LotroKoniecDev.TranslationSystem.Contracts.GameVersions
@using LotroKoniecDev.TranslationSystem.Contracts.Hateoas
@using LotroKoniecDev.TranslationSystem.Primitives.Aggregates.GameVersionAggregate
@using LotroKoniecDev.Frontend.Infrastructure.Errors
@using LotroKoniecDev.Frontend.Infrastructure.Formatting
@inject GameVersionsLoader Loader
@inject NavigationManager Navigation

<PageTitle>Wersje gry — lotro-translator.pl</PageTitle>

<section class="container page-head">
    <div>
        <h1>Wersje gry</h1>
        <p class="lede">
            Przeglądaj zarejestrowane wersje gry LOTRO i ich stan w cyklu aktualizacji. Wersje nie pojawiają
            się tu same — wpisuje je ręcznie administrator. Może też usunąć błędnie dodaną wersję, dopóki nie
            zaimportowano do niej tekstów.
        </p>
    </div>
</section>

<section class="container content-wrap">
    @if (_versionsProblem is not null)
    {
        <div class="error-message" role="alert">
            <span class="em-ico" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
                    <path d="M12 9v4"/><path d="M12 17h.01"/>
                </svg>
            </span>
            <div class="em-body">
                <ApiProblemAlert Problem="@_versionsProblem"
                                 Fallback="Nie udało się wczytać listy wersji gry."
                                 HeadlineClass="t"/>
            </div>
        </div>

        <PostedFormTarget IsPageForm="IsOwnForm"/>
    }

    @if (_actionProblem is not null)
    {
        <div class="status-message status-error" role="alert">
            <ApiProblemAlert Problem="@_actionProblem" Fallback="Operacja nie powiodła się."/>
        </div>
    }
    else if (_actionMessage is not null)
    {
        <div class="status-message status-success" role="status">
            <p>@_actionMessage</p>
        </div>
    }

    @if (_registerHref is not null)
    {
        <section class="panel">
            <header class="panel-head">
                <h2>Zarejestruj wersję ręcznie</h2>
                <span class="panel-aside">Operacja administratora</span>
            </header>
            <div class="panel-body">
                <p class="lede">
                    Podaj wersję w notacji LOTRO (np. <code class="mono">48.0</code>). Nowa wersja pojawi się jako
                    nieprzetworzona.
                </p>
                <form method="post" @formname="@RegisterFormName" @onsubmit="RegisterAsync" class="form-row">
                    <AntiforgeryToken/>
                    <div class="field">
                        <label for="new-version">Wersja</label>
                        <input id="new-version" name="RegisterInput.Version" type="text"
                               maxlength="@MaxVersionLength" placeholder="np. 48.0"
                               value="@(RegisterInput?.Version)" autocomplete="off"/>
                    </div>
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-primary">Zarejestruj</button>
                    </div>
                </form>
            </div>
        </section>
    }

    @if (_versions is null && _versionsProblem is null)
    {
        <div class="loading-indicator">
            <span class="li-spin"></span> Wczytywanie wersji gry…
        </div>
    }
    else if (_versions is { Count: 0 })
    {
        <div class="empty">
            <span class="empty-glyph" aria-hidden="true">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v18"/>
                    <path d="M5 8h14"/>
                    <path d="M5 8a7 7 0 0 0 14 0"/>
                </svg>
            </span>
            <h2>Brak wersji gry</h2>
            <p>Nie zarejestrowano jeszcze żadnej wersji gry.</p>
        </div>
    }
    else if (_versions is not null)
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Wersja</th>
                        <th scope="col">Data rejestracji</th>
                        <th scope="col" class="col-status">Status</th>
                        <th scope="col" class="col-actions"><span class="visually-hidden">Akcje</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (GameVersionResponse version in _versions)
                    {
                        @* Sent only to an admin, for a version no import has run against (#624). *@
                        LinkDto? deleteLink = version.Links.FindLink(Rels.Delete);
                        bool asksToDelete = deleteLink is not null && IsConfirmingDeleteOf(version.Id);
                        <tr class="@(asksToDelete ? "has-delete-question" : null)">
                            <td class="mono">@version.Version</td>
                            <td>@version.DetectedAt.ToPolandTimeText()</td>
                            <td class="col-status">
                                <span class="badge @GameVersionStatusDisplay.BadgeClass(version.Status)">
                                    <span class="dot"></span>@GameVersionStatusDisplay.Label(version.Status)
                                </span>
                            </td>
                            <td class="col-actions">
                                @if (asksToDelete)
                                {
                                    @* Inert, with the link's classes, so it keeps the link's place: the second
                                       click of a double click on "Usuń" lands here (#549). *@
                                    <span class="btn btn-ghost btn-sm is-disabled" aria-disabled="true">Usuń</span>
                                }
                                else if (deleteLink is not null)
                                {
                                    <a class="btn btn-ghost btn-sm" href="@ConfirmDeleteUri(version.Id)">Usuń</a>
                                }
                            </td>
                        </tr>
                        @if (asksToDelete && deleteLink is { } confirmedDeleteLink)
                        {
                            @* A row of its own, so the question never widens the table or moves "Usuń" (#549).
                               The form sets no action, so Blazor writes this address, which draws the form
                               again on the post (#1122). *@
                            <tr class="version-delete-question">
                                <td colspan="4">
                                    <div class="version-delete-confirm">
                                        <span role="status">Na pewno usunąć wersję @(version.Version)?</span>
                                        <form method="post" @formname="@DeleteFormName(version.Id)"
                                              @onsubmit="() => DeleteAsync(confirmedDeleteLink.Href)">
                                            <AntiforgeryToken/>
                                            <button type="submit" class="btn btn-danger btn-sm">Tak, usuń</button>
                                        </form>
                                        <a class="btn btn-ghost btn-sm" href="@PageUri">Anuluj</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code
{
    /// <summary>
    /// Repeats the server's <c>LotroNotationVersion.VersionMaxLength</c>, which the Frontend cannot
    /// reference. Only a convenience: the server's validation still decides.
    /// </summary>
    private const int MaxVersionLength = 11;

    private const string RegisterFormName = "register-version";
    private const string DeleteFormNamePrefix = "delete-";

    private const string PageUri = "/game-versions";
    private const string ConfirmDeleteParameter = "confirm-delete";
    private const string DeletedParameter = "deleted";
    private const string DeletedUri = $"{PageUri}?{DeletedParameter}=true";

    private IReadOnlyList<GameVersionResponse>? _versions;
    private ProblemDetails? _versionsProblem;
    private ProblemDetails? _actionProblem;
    private string? _actionMessage;

    /// <summary>
    /// Sent only to admins, so it both shows the form and gives the URL it posts to (#610).
    /// </summary>
    private string? _registerHref;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = RegisterFormName)]
    private RegisterFormModel? RegisterInput { get; set; }

    /// <summary>
    /// The row whose delete waits for the second click (#549). Read as text, so a value that is not an id
    /// only hides the question instead of failing the page (#1356).
    /// </summary>
    [SupplyParameterFromQuery(Name = ConfirmDeleteParameter)]
    private string? ConfirmDelete { get; set; }

    /// <summary>
    /// Set by the redirect after a delete, so the confirmation needs no per-user state on the server. A
    /// manual reload shows it again, which is harmless.
    /// </summary>
    [SupplyParameterFromQuery(Name = DeletedParameter)]
    private string? Deleted { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // A property initializer is rejected for a [SupplyParameterFromForm] model (BL0008).
        RegisterInput ??= new RegisterFormModel();

        // A post keeps the flag only because the address still has it, so it shows none (#1122).
        if (PostedForm.NameOf(HttpContext) is null && bool.TryParse(Deleted, out bool deleted) && deleted)
        {
            _actionMessage = "Usunięto wersję gry.";
        }

        // The register form and the delete links follow the admin-only rels, never a role check (#158).
        await LoadVersionsAsync();
    }

    private async Task LoadVersionsAsync()
    {
        ApiResult<CollectionResponse<GameVersionResponse>> result = await Loader.ListGameVersionsAsync(CancellationToken.None);
        if (result.IsSuccess)
        {
            _versions = [.. result.Value.Items];
            _registerHref = result.Value.Links.FindLink(Rels.Register)?.Href;
            _versionsProblem = null;
        }
        else
        {
            _versions = null;
            _registerHref = null;
            _versionsProblem = result.ProblemDetails;
        }
    }

    private async Task RegisterAsync()
    {
        _actionProblem = null;
        _actionMessage = null;

        if (_registerHref is not { } registerHref)
        {
            return;
        }

        string version = RegisterInput?.Version?.Trim() ?? string.Empty;
        if (version.Length == 0)
        {
            _actionProblem = ApiProblemCopy.FrontendAuthored("Podaj wersję gry.");
            await LoadVersionsAsync();
            return;
        }

        ApiResult<GameVersionResponse> result =
            await Loader.RegisterGameVersionAsync(registerHref, version, CancellationToken.None);
        if (result.IsSuccess)
        {
            _actionMessage = $"Zarejestrowano wersję {result.Value.Version}.";
            RegisterInput = new RegisterFormModel();
        }
        else
        {
            _actionProblem = result.ProblemDetails;
        }

        await LoadVersionsAsync();
    }

    private async Task DeleteAsync(string deleteHref)
    {
        _actionProblem = null;
        _actionMessage = null;

        ApiResult result = await Loader.DeleteGameVersionAsync(deleteHref, CancellationToken.None);
        if (result.IsSuccess)
        {
            // Redirect after post: a reload is a plain GET and cannot send the delete again. A failure does
            // not redirect, so the error and the question stay on screen.
            Navigation.NavigateTo(DeletedUri);
            return;
        }

        _actionProblem = result.ProblemDetails;
        await LoadVersionsAsync();
    }

    private bool IsConfirmingDeleteOf(GameVersionId id) =>
        Guid.TryParse(ConfirmDelete, out Guid confirmedId) && confirmedId == id.Value;

    private static string ConfirmDeleteUri(GameVersionId id) =>
        string.Create(CultureInfo.InvariantCulture, $"{PageUri}?{ConfirmDeleteParameter}={id.Value}");

    /// <summary>
    /// A form name per row: static SSR sends the post to the matching <c>@@formname</c> and rebuilds that
    /// row's <c>@@onsubmit</c> closure.
    /// </summary>
    private static string DeleteFormName(GameVersionId id) =>
        string.Create(CultureInfo.InvariantCulture, $"{DeleteFormNamePrefix}{id.Value}");

    /// <summary>
    /// A failed load leaves no row to read the ids from, so a delete form is known by its name alone
    /// (#1122).
    /// </summary>
    private static bool IsOwnForm(string formName) =>
        formName == RegisterFormName
        || (formName.StartsWith(DeleteFormNamePrefix, StringComparison.Ordinal)
            && Guid.TryParse(formName.AsSpan(DeleteFormNamePrefix.Length), out _));

    private sealed class RegisterFormModel
    {
        public string? Version { get; set; }
    }
}
