<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Windows reads this manifest; Avalonia's own template ships it. Without the supportedOS entry
       Windows reports an older version to the process. -->
  <assemblyIdentity version="1.0.0.0" name="LotroPoPolsku.Desktop"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker, as in the default manifest the CLI gets. Without this entry Windows treats a
             32-bit app as a legacy one and quietly redirects its writes under Program Files to the
             VirtualStore folder, so a patch would never reach the real DAT. Elevation is #42's job,
             behind an abstraction (ADR-0033 §2). -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
