{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AuthDatabase": "Host=localhost;Port=5432;Database=lotro_auth;Username=postgres;Password=changeme"
  },
  "OpenIddict": {
    "Issuer": "https://localhost:5003",
    "AccessTokenLifetimeMinutes": 5,
    "RefreshTokenLifetimeDays": 14,
    "EncryptionKey": {
      "Key": ""
    },
    "SigningKey": {
      "RsaPrivateKeyXml": ""
    },
    "ApiClientSecret": "dev-api-secret-min-32-characters-long",
    "WebClient": {
      "RedirectUris": ["https://localhost:7017/callback"],
      "PostLogoutRedirectUris": ["https://localhost:7017"]
    }
  },
  "DataProtection": {
    "KeyRingPath": ""
  },
  "AdminUser": {
    "Username": "admin",
    "Email": "",
    "Password": ""
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "OpenIddict": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/auth-system-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "Email": {
    "SenderEmail": "noreply@lotro-translator.pl",
    "Sender": "lotro-translator.pl",
    "Host": "localhost",
    "Port": 1025,
    "Mode": "None",
    "TimeoutSeconds": 10,
    "MaxSendAttempts": 3
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "rabbitmq",
    "Password": "changeme",
    "VirtualHost": "/"
  }
}
