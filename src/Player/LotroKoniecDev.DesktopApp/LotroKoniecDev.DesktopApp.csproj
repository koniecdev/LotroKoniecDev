<Project Sdk="Microsoft.NET.Sdk">
    <!-- The patcher's Windows Infrastructure is net10.0-windows/x86 because of datexport.dll, so the
         exe that loads it is too, exactly like the CLI. A Windows exe is also what runs under
         Wine/Proton (ADR-0033 §2). The UI itself lives in the cross-platform Presentation project. -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <PlatformTarget>x86</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>LotroPoPolsku</AssemblyName>
        <ApplicationIcon>..\LotroKoniecDev.DesktopApp.Presentation\Assets\app.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
        <PublishSingleFile>true</PublishSingleFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- The app runs as administrator, so it must not load code from a folder the player can change
         (ADR-0069 amendment of 2026-11-18). The native libraries ship loose next to the exe, under
         Program Files, instead of being unpacked into the player's %TEMP% at start. Startup hooks
         (DOTNET_STARTUP_HOOKS in the player's own environment) are off in Release; a Debug build keeps
         them for hot reload. -->
    <PropertyGroup>
        <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <StartupHookSupport>false</StartupHookSupport>
    </PropertyGroup>

    <!-- 0.0.0 is a developer build, which never checks for updates. The release workflow publishes
         with -p:Version=X.Y.Z, and the app reads the stamp back as text and parses it with the same
         parser as the release tags (spec 0016). -->
    <PropertyGroup>
        <Version>0.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyMetadata Include="DesktopVersion" Value="$(Version)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.File" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="LotroKoniecDev.Tests.Infrastructure" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LotroKoniecDev.DesktopApp.Presentation\LotroKoniecDev.DesktopApp.Presentation.csproj" />
        <ProjectReference Include="..\..\Patcher\LotroKoniecDev.Application\LotroKoniecDev.Application.csproj" />
        <ProjectReference Include="..\..\Patcher\LotroKoniecDev.Infrastructure\LotroKoniecDev.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Patcher\LotroKoniecDev.Infrastructure.Windows\LotroKoniecDev.Infrastructure.Windows.csproj" />
    </ItemGroup>

    <!-- LEGAL-12 (spec 0011): the player-facing risk NOTICE ships next to the published exe, as with the CLI -->
    <ItemGroup>
        <None Include="..\..\..\NOTICE" Link="NOTICE" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
