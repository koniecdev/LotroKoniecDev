@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Options
@using LotroKoniecDev.Frontend.Infrastructure.CookieConsent
@using LotroKoniecDev.Frontend.Settings
@inject IOptions<AuthSystemSettings> AuthSystemOptions
@inject IHttpContextAccessor HttpContextAccessor

@* The notice only informs, because every cookie we set is strictly necessary. So it shows once: the page
   that shows it also sets the cookie, and the browser closes it with no request, so nothing typed or ticked
   on the page is lost (#1339). A cookie that needs consent would break this. *@
@if (_shown)
{
    <dialog class="cookie-bar" open aria-label="Informacja o plikach cookie">
        <div class="container cookie-bar-inner">
            <div class="cookie-bar-copy">
                <span class="cookie-bar-ico" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5Z"/>
                        <path d="M8.5 8.5h.01M15 9.5h.01M9.5 15h.01M14 14.5h.01"/>
                    </svg>
                </span>
                <p class="cookie-bar-text">
                    Używamy wyłącznie niezbędnych plików cookie, koniecznych do bezpiecznego działania
                    serwisu — nie stosujemy śledzenia ani reklam. Szczegóły znajdziesz w
                    <a href="@PrivacyPolicyCookiesUrl" target="_blank" rel="noopener">polityce prywatności</a>.
                </p>
            </div>
            <form class="cookie-bar-form" method="dialog">
                <button type="submit" class="btn btn-primary">Rozumiem</button>
            </form>
        </div>
    </dialog>
}

@code {
    private bool _shown;

    private string PrivacyPolicyCookiesUrl =>
        $"{AuthSystemOptions.Value.BaseUrl.TrimEnd('/')}/Account/PrivacyPolicy#cookies";

    // It runs in the layout's first render pass, before a streamed page writes its first byte.
    protected override void OnInitialized()
    {
        HttpContext? httpContext = HttpContextAccessor.HttpContext;
        _shown = !CookieConsentCookie.WasShown(httpContext?.Request.Cookies[CookieConsentCookie.Name]);
        if (!_shown || httpContext is null || httpContext.Response.HasStarted)
        {
            return;
        }

        httpContext.Response.Cookies.Append(
            CookieConsentCookie.Name,
            CookieConsentCookie.Value,
            CookieConsentCookie.BuildOptions(httpContext.Request.IsHttps));
    }
}
