{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDatabase": ""
  },
  "OpenIddict": {
    "Issuer": "https://auth.lotro.koniec.dev",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 14,
    "EncryptionKey": {
      "Key": ""
    },
    "SigningKey": {
      "RsaPrivateKeyXml": ""
    },
    "ApiClientSecret": "",
    "WebClient": {
      "RedirectUris": [
        "https://lotro.koniec.dev/callback"
      ],
      "PostLogoutRedirectUris": [
        "https://lotro.koniec.dev"
      ]
    }
  },
  "DataProtection": {
    "KeyRingPath": ""
  },
  "AdminUser": {
    "Username": "",
    "Email": "",
    "Password": ""
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Enrichers.CorrelationId"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "OpenIddict": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithCorrelationId", "WithCorrelationIdHeader"]
  },
  "Email": {
    "SenderEmail": "noreply@lotro.koniec.dev",
    "Sender": "lotro.koniec.dev",
    "Host": "mailpit",
    "Port": 1025,
    "Mode": "StartTls",
    "TimeoutSeconds": 10,
    "MaxSendAttempts": 3
  }
}
