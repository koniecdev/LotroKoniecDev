# Template for /opt/obs/.env — the env file of compose.observability.yaml (ADR-0050).
# Copy to the box, fill in, chmod 600. NEVER commit a filled copy.
#
# ONE file, two roles. COMPOSE_PROFILES is what decides which box you are on. It must be EXACTLY
# `backend` or empty — it also picks the agent's ship file, so a comma list or a typo would select
# the wrong one; `preflight` refuses to start the stack on any other value. For the same reason this
# project is brought up with THIS file and never with `docker compose --profile backend`: the flag
# sets the profile without setting the variable.
#
#   staging box (lotro-staging) — BACKEND + agent
#     COMPOSE_PROFILES=backend
#     OBS_BOX=lotro-staging
#     OBS_ENVIRONMENT=staging
#     OBS_NETWORK=lotro-staging_obs
#     OBS_ALLOY_OOM_SCORE_ADJ=-300
#     (leave OBS_BACKEND_HOST / OBS_PUSH_* blank — the backend role writes to the containers next
#      door, and its ship file never reads them)
#
#   prod box (lotro-prod) — AGENT ONLY. Note it still carries the GF_* / OBS_ALERT_EMAIL lines
#   below, as placeholders: compose interpolates every service before it applies profiles, so their
#   `:?` guards are evaluated even though Grafana never starts here. That is the price of one file
#   for both roles, and the guards are worth it — an EMPTY Grafana password is not an error to
#   Grafana, it silently falls back to admin/admin.
#     COMPOSE_PROFILES=
#     OBS_BOX=lotro-prod
#     OBS_ENVIRONMENT=production
#     OBS_NETWORK=lotro-prod_obs
#     OBS_ALLOY_OOM_SCORE_ADJ=300
#     OBS_BACKEND_HOST=obs.lotro-translator.pl
#     OBS_PUSH_USER / OBS_PUSH_PASSWORD = the credential the backend box's Caddy checks; its
#       /opt/lotro/.env holds the bcrypt hash of this same password (runbook → "Bringing up the
#       prod agent"). The GF_* and OBS_ALERT_EMAIL lines below are backend-only: leave them blank.
#
# The same switch picks the agent's ship file: `backend` → alloy/ship.backend.alloy, empty →
# alloy/ship.agent.alloy (TLS + basic auth across the box boundary — ADR-0050 §4, #755).

COMPOSE_PROFILES=backend

# --- The network this project joins (ADR-0050 §2) ---
# `${COMPOSE_PROJECT_NAME}_obs` of the LotroKoniecDev stack on this box, created by its CD rollout —
# so that stack must have deployed at least once since #755 before this project can start
# (`docker network ls | grep _obs`). Caddy sits on it to proxy the other box's pushes.
OBS_NETWORK=lotro-staging_obs

# --- Identity of this box. Stamped onto every log line, metric and trace that leaves it. ---
# OBS_ENVIRONMENT is the ONLY thing that separates the two environments in Grafana: both boxes run
# their apps with ASPNETCORE_ENVIRONMENT=Production, so nothing else can carry the distinction.
OBS_BOX=lotro-staging
OBS_ENVIRONMENT=staging

# --- Memory pressure: where the agent sits when the BOX runs out of memory (#786) ---
# The one value in this project that INVERTS between the two roles, which is why it is a knob and
# not a literal: `alloy` carries no profile, so both boxes render the same service definition.
#   backend box (staging):    OBS_ALLOY_OOM_SCORE_ADJ=-300   the most protected container here —
#     but not because prod runs through it. Prod's agent pushes through Caddy straight into
#     loki/prometheus/tempo (ADR-0050 §4); this agent carries only its own box. It earns the depth
#     as the single OTLP receiver and log tailer for both application stacks on the box, and as the
#     source of the host metrics the fleet rules read. The applications next door are the expendable
#     ones (OOM_SCORE_ADJ_APP=500 in /opt/lotro/.env).
#   agent-only box (prod):    OBS_ALLOY_OOM_SCORE_ADJ=300    the box's designated FIRST victim.
#     Losing the agent costs telemetry; losing anything else on that box costs the product. It must
#     be POSITIVE, not merely higher than the apps: the host's own daemons sit at 0, so the negative
#     value the other box uses would leave the kernel taking this one apart daemon by daemon before
#     ever reaching the container the policy names.
# compose fails loudly without this (${VAR:?}) — including on the agent-only box, where every
# service is interpolated before profiles are applied — and `preflight` additionally refuses to
# start the stack when the SIGN does not match the role, because a wrong sign is silent everywhere
# else: the box comes up healthy and ships telemetry, and the only symptom is that a box-level OOM
# would kill exactly the wrong container.
OBS_ALLOY_OOM_SCORE_ADJ=-300

# --- Where the agent's OTLP receiver is reachable from ---
# BOTH MUST be docker bridge gateways, never 0.0.0.0 and never the public IP. A published port on
# 0.0.0.0 is reachable from the internet even with ufw denying it: Docker inserts its DNAT rules
# ahead of the ufw chain (scripts/hetzner/bootstrap.sh:286).
#
# Two addresses because the two stacks live on two segregated networks and Alloy joins neither of
# them (ADR-0050 §3); each stack reaches the agent through its own gateway.
OBS_OTLP_BIND_LOTRO=10.60.0.1
OBS_OTLP_BIND_TKS=10.61.0.1

# --- Agent-only boxes: where to push (blank on the backend box) ---
# The backend box's ingest vhost and the credential it checks (ADR-0050 §4). The password is the
# plaintext twin of the OBS_PUSH_PASSWORD_HASH the backend box holds in /opt/lotro/.env — mint it
# with `openssl rand -base64 24`, hash it there, never write the plaintext anywhere but here.
OBS_BACKEND_HOST=
OBS_PUSH_USER=
OBS_PUSH_PASSWORD=

# --- Grafana (backend box; placeholders on an agent-only box — see the header) ---
# Bound to 127.0.0.1 on the box; there is no public vhost. Reach it with an ssh tunnel:
#   ssh -L 3000:127.0.0.1:3000 lotro-staging     → http://localhost:3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
OBS_GRAFANA_PORT=3000

# --- Alert delivery (#713; backend box — placeholders on an agent-only box) ---
# Reuses the Brevo SMTP credential the apps already hold. GF_SMTP_FROM_ADDRESS must be a sender
# Brevo has authenticated (DKIM + SPF) — anything else is accepted and then dropped in silence.
OBS_ALERT_EMAIL=
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp-relay.brevo.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
GF_SMTP_FROM_NAME=Grafana (Hetzner fleet)
