<Project Sdk="Microsoft.NET.Sdk">
    <!-- Plain net10.0 on purpose: nothing here needs Windows, so it builds and is tested on Linux.
         The native DLLs and the Windows adapters live in LotroKoniecDev.Infrastructure.Windows
         (ADR-0033, 2026-11-18 amendment). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="LotroKoniecDev.Infrastructure.Tests.Integration" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LotroKoniecDev.Domain\LotroKoniecDev.Domain.csproj"/>
        <ProjectReference Include="..\LotroKoniecDev.Application\LotroKoniecDev.Application.csproj"/>
        <!-- The HATEOAS vendor media type is a cross-service convention centralised in Utilities on
             purpose: the TMS attaches discovery links only to a request that accepts it, so a
             re-typed copy drifting here would silently strip the CLI of every entry point (#611). -->
        <ProjectReference Include="..\..\Utilities\LotroKoniecDev.Hateoas.Abstractions\LotroKoniecDev.Hateoas.Abstractions.csproj"/>
    </ItemGroup>

</Project>
